"HLD_max_subarray": {
  "prefix": "HLD_max_subarray",
  "body": [
    "#include <bits/stdc++.h>",
    "using namespace std;",
    "",
    "struct Node",
    "{",
    "    long long sum, pref, suff, ans;",
    "};",
    "",
    "const long long maxN = 3e5 + 9;",
    "long long a[maxN];",
    "Node t[4 * maxN];",
    "",
    "Node mergeNodes(const Node &left, const Node &right)",
    "{",
    "    Node parent;",
    "    parent.sum = left.sum + right.sum;",
    "    parent.pref = max(left.pref, left.sum + right.pref);",
    "    parent.suff = max(right.suff, right.sum + left.suff);",
    "    parent.ans = max({left.ans, right.ans, left.suff + right.pref});",
    "    return parent;",
    "}",
    "",
    "Node reverseNode(Node n)",
    "{",
    "    swap(n.pref, n.suff);",
    "    return n;",
    "}",
    "",
    "void build(long long node, long long start, long long end)",
    "{",
    "    if (start == end)",
    "    {",
    "        long long val = a[start];",
    "        t[node] = {val, max(0LL, val), max(0LL, val), max(0LL, val)};",
    "        return;",
    "    }",
    "    long long mid = (start + end) / 2;",
    "    build(2 * node, start, mid);",
    "    build(2 * node + 1, mid + 1, end);",
    "    t[node] = mergeNodes(t[2 * node], t[2 * node + 1]);",
    "}",
    "",
    "void update(long long node, long long start, long long end, long long idx, long long val)",
    "{",
    "    if (idx < start || idx > end)",
    "        return;",
    "    if (start == end)",
    "    {",
    "        a[idx] = val;",
    "        t[node] = {val, max(0LL, val), max(0LL, val), max(0LL, val)};",
    "        return;",
    "    }",
    "    long long mid = (start + end) / 2;",
    "    update(2 * node, start, mid, idx, val);",
    "    update(2 * node + 1, mid + 1, end, idx, val);",
    "    t[node] = mergeNodes(t[2 * node], t[2 * node + 1]);",
    "}",
    "",
    "Node query(long long node, long long start, long long end, long long l, long long r)",
    "{",
    "    if (end < l || r < start)",
    "        return {0, 0, 0, 0};",
    "    if (start >= l && end <= r)",
    "        return t[node];",
    "    long long mid = (start + end) / 2;",
    "    return mergeNodes(query(2 * node, start, mid, l, r),",
    "                      query(2 * node + 1, mid + 1, end, l, r));",
    "}",
    "",
    "vector<long long> g[maxN];",
    "long long parent_[maxN], depth_[maxN], heavy[maxN], head[maxN], pos[maxN], subtreeSize[maxN];",
    "long long cur_pos = 0;",
    "",
    "long long dfs(long long u, long long p)",
    "{",
    "    long long size = 1, max_c_size = 0;",
    "    heavy[u] = -1;",
    "    for (long long v : g[u])",
    "    {",
    "        if (v != p)",
    "        {",
    "            parent_[v] = u;",
    "            depth_[v] = depth_[u] + 1;",
    "            long long c_size = dfs(v, u);",
    "            size += c_size;",
    "            if (c_size > max_c_size)",
    "            {",
    "                max_c_size = c_size;",
    "                heavy[u] = v;",
    "            }",
    "        }",
    "    }",
    "    subtreeSize[u] = size;",
    "    return size;",
    "}",
    "",
    "void decompose(long long u, long long h)",
    "{",
    "    head[u] = h;",
    "    pos[u] = ++cur_pos;",
    "    if (heavy[u] != -1)",
    "        decompose(heavy[u], h);",
    "    for (long long v : g[u])",
    "        if (v != parent_[u] && v != heavy[u])",
    "            decompose(v, v);",
    "}",
    "",
    "void init(long long root)",
    "{",
    "    cur_pos = 0;",
    "    dfs(root, 0);",
    "    decompose(root, root);",
    "}",
    "",
    "long long lca(long long u, long long v)",
    "{",
    "    while (head[u] != head[v])",
    "    {",
    "        if (depth_[head[u]] > depth_[head[v]])",
    "            u = parent_[head[u]];",
    "        else",
    "            v = parent_[head[v]];",
    "    }",
    "    return (depth_[u] < depth_[v]) ? u : v;",
    "}",
    "",
    "vector<Node> collectUp(long long u, long long anc)",
    "{",
    "    vector<Node> segs;",
    "    while (head[u] != head[anc])",
    "    {",
    "        segs.push_back(query(1, 1, cur_pos, pos[head[u]], pos[u]));",
    "        u = parent_[head[u]];",
    "    }",
    "    if (pos[anc] <= pos[u])",
    "        segs.push_back(query(1, 1, cur_pos, pos[anc], pos[u]));",
    "    return segs;",
    "}",
    "",
    "long long pathMaxSubarray(long long u, long long v)",
    "{",
    "    long long l = lca(u, v);",
    "",
    "    vector<Node> leftSegs = collectUp(u, l);",
    "    for (auto &s : leftSegs)",
    "        s = reverseNode(s);",
    "",
    "    vector<Node> rightSegs;",
    "    long long x = v;",
    "    while (head[x] != head[l])",
    "    {",
    "        rightSegs.push_back(query(1, 1, cur_pos, pos[head[x]], pos[x]));",
    "        x = parent_[head[x]];",
    "    }",
    "    if (pos[l] + 1 <= pos[x])",
    "        rightSegs.push_back(query(1, 1, cur_pos, pos[l] + 1, pos[x]));",
    "",
    "    Node res;",
    "    bool has = false;",
    "    for (auto &s : leftSegs)",
    "    {",
    "        if (!has)",
    "        {",
    "            res = s;",
    "            has = true;",
    "        }",
    "        else",
    "            res = mergeNodes(res, s);",
    "    }",
    "    for (long long i = (long long)rightSegs.size() - 1; i >= 0; i--)",
    "    {",
    "        if (!has)",
    "        {",
    "            res = rightSegs[i];",
    "            has = true;",
    "        }",
    "        else",
    "            res = mergeNodes(res, rightSegs[i]);",
    "    }",
    "",
    "    if (!has)",
    "        return 0;",
    "    return max(0LL, res.ans);",
    "}",
    "",
    "signed main()",
    "{",
    "    ios::sync_with_stdio(false);",
    "    cin.tie(nullptr);",
    "",
    "    long long n, q;",
    "    cin >> n >> q;",
    "",
    "    vector<long long> val(n + 1);",
    "    for (long long i = 1; i <= n; i++)",
    "    {",
    "        cin >> val[i];",
    "    }",
    "",
    "    for (long long i = 1; i < n; i++)",
    "    {",
    "        long long u, v;",
    "        cin >> u >> v;",
    "        g[u].push_back(v);",
    "        g[v].push_back(u);",
    "    }",
    "",
    "    init(1);",
    "",
    "    for (long long u = 1; u <= n; u++)",
    "    {",
    "        a[pos[u]] = val[u];",
    "    }",
    "    build(1, 1, n);",
    "",
    "    while (q--)",
    "    {",
    "        long long type;",
    "        cin >> type;",
    "",
    "        if (type == 1)",
    "        {",
    "            long long v, x;",
    "            cin >> v >> x;",
    "            update(1, 1, n, pos[v], x);",
    "        }",
    "        else",
    "        {",
    "            long long v, u;",
    "            cin >> v >> u;",
    "            cout << pathMaxSubarray(v, u) << endl;",
    "        }",
    "    }",
    "    $0",
    "    return 0;",
    "}"
  ],
  "description": ""
}
}
