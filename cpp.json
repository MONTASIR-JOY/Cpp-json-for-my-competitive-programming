"kmp": {
  "prefix": "kmp",
  "body": [
    "vector<long long> kmp(const string &s)",
    "{",
    "    long long n = s.size();",
    "    vector<long long> pi(n, 0);",
    "    for (long long i = 1; i < n; i++)",
    "    {",
    "        long long j = pi[i - 1];",
    "        while (j > 0 && s[i] != s[j])",
    "        {",
    "            j = pi[j - 1];",
    "        }",
    "        if (s[i] == s[j])",
    "        {",
    "            j++;",
    "        }",
    "        pi[i] = j;",
    "    }",
    "    return pi;",
    "}"
  ],
  "description": "kmp"
