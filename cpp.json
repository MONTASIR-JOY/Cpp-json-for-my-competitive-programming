  "body": [
    "#include<bits/stdc++.h>",
    "using namespace std;",
    "const long long MOD = 1e9 + 7;",
    "",
    "class Comb {",
    "    vector<long long> f, invf;",
    "    long long pow(long long a, long long b) const { ",
    "        long long r = 1; a %= MOD;",
    "        while (b) { if (b & 1) r = (r * a) % MOD; a = (a * a) % MOD; b >>= 1; }",
    "        return r; ",
    "    }",
    "public:",
    "    Comb(long long n) : f(n + 1), invf(n + 1) {",
    "        f[0] = 1;",
    "        for (long long i = 1; i <= n; i++) f[i] = (f[i - 1] * i) % MOD;",
    "        invf[n] = pow(f[n], MOD - 2);",
    "        for (long long i = n - 1; i >= 0; i--) invf[i] = (invf[i + 1] * (i + 1)) % MOD;",
    "    }",
    "    long long nCr(long long n, long long r) const { ",
    "        return r < 0 || r > n ? 0 : (f[n] * invf[r] % MOD * invf[n - r]) % MOD; ",
    "    }",
    "    long long nPr(long long n, long long r) const { ",
    "        return r < 0 || r > n ? 0 : (f[n] * invf[n - r]) % MOD; ",
    "    }",
    "};",
    "signed main()",
    "{",
    "    ios::sync_with_stdio(false);",
    "    cin.tie(nullptr);",
    "",
    "    Comb comb(200005);",
    "    ",
    "    $0",
    "    return 0;",
    "}"
  ],
  "description": ""
},
"modInverse": {
  "prefix": "modinverse",
  "body": [
    "long long modInverse(long long a, long long m) ",
    "{",
    "    long long res = 1;",
    "    long long power = m - 2;",
    "    while (power > 0)",
    "    {",
    "        if (power & 1)",
    "        {",
    "            res = (res * a) % m;",
    "        }",
    "        a = (a * a) % m;",
    "        power >>= 1;",
    "    }",
    "    return res;",
    "}"
  ],
  "description": ""
},
"toposort": {
  "prefix": "toposort",
  "body": [
    "#include <bits/stdc++.h>",
    "using namespace std;",
    "",
    "const long long MXN = 3e5 + 5;",
    "",
    "vector<long long> g[MXN];",
    "vector<long long> topo;",
    "long long state[MXN];",
    "bool hasCycle;",
    "",
    "void dfs(long long u)",
    "{",
    "    state[u] = 1;",
    "",
    "    for (long long v : g[u])",
    "    {",
    "        if (state[v] == 0)",
    "        {",
    "            dfs(v);",
    "            if (hasCycle) return;",
    "        }",
    "        else if (state[v] == 1)",
    "        {",
    "            hasCycle = true;",
    "            return;",
    "        }",
    "    }",
    "",
    "    state[u] = 2;",
    "    topo.push_back(u);",
    "}",
    "",
    "vector<long long> topological_sort(long long n)",
    "{",
    "    topo.clear();",
    "    hasCycle = false;",
    "",
    "    for (long long i = 1; i <= n; i++)",
    "        state[i] = 0;",
    "",
    "    for (long long i = 1; i <= n; i++)",
    "    {",
    "        if (state[i] == 0)",
    "        {",
    "            dfs(i);",
    "            if (hasCycle) return {};",
    "        }",
    "    }",
    "",
    "    reverse(topo.begin(), topo.end());",
    "    return topo;",
    "}",
    "",
    "signed main()",
    "{",
    "    ios::sync_with_stdio(false);",
    "    cin.tie(nullptr);",
    "",
    "    long long n, m;",
    "    cin >> n >> m;",
    "",
    "    for (long long i = 1; i <= n; i++)",
    "    {",
    "        g[i].clear();",
    "    }",
    "",
    "    while (m--)",
    "    {",
    "        long long u, v;",
    "        cin >> u >> v;",
    "        g[u].push_back(v);",
    "    }",
    "",
    "    vector<long long> ans = topological_sort(n);",
    "",
    "    if (ans.empty())",
    "    {",
    "        cout << \"Cycle Found\" << endl;",
    "    }",
    "    else",
    "    {",
    "        for (long long i : ans)",
    "        {",
    "            cout << i << \" \";",
    "        }",
    "        cout << endl;",
    "    }",
    "",
    "    return 0;",
    "}"
  ],
  "description": ""
},
"dijkstra": {
  "prefix": "dijkstra",
  "body": [
    "#include <bits/stdc++.h>",
    "using namespace std;",
    "",
    "const long long mxn = 2e5 + 9;",
    "",
    "vector<pair<long long, long long>> g[mxn];",
    "vector<bool> vis(mxn);",
    "vector<long long> dis(mxn);",
    "vector<long long> parent(mxn);",
    "",
    "void dijkstra(long long src)",
    "{",
    "    priority_queue<pair<long long, long long>, vector<pair<long long, long long>>, greater<pair<long long, long long>>> pq;",
    "",
    "    dis[src] = 0;",
    "    pq.push({0, src});",
    "",
    "    while (!pq.empty())",
    "    {",
    "        auto [d, u] = pq.top();",
    "        pq.pop();",
    "",
    "        if (vis[u])",
    "            continue;",
    "        vis[u] = true;",
    "",
    "        for (auto [v, w] : g[u])",
    "        {",
    "            if (!vis[v] && dis[u] + w < dis[v])",
    "            {",
    "                dis[v] = dis[u] + w;",
    "                parent[v] = u;",
    "                pq.push({dis[v], v});",
    "            }",
    "        }",
    "    }",
    "}",
    "",
    "signed main()",
    "{",
    "    ios::sync_with_stdio(false);",
    "    cin.tie(nullptr);",
    "",
    "    long long n;",
    "    cin >> n;",
    "",
    "    for (long long i = 0; i <= n;i++)",
    "    {",
    "        g[i].clear();",
    "        vis[i] = false;",
    "        dis[i] = LLONG_MAX;",
    "        parent[i] = -1;",
    "    }",
    "",
    "    for (long long i = 0; i < n - 1;i++)",
    "    {",
    "        long long u, v;",
    "        long long w;",
    "        cin >> u >> v >> w;",
    "        g[u].push_back({v, w});",
    "        g[v].push_back({u, w});",
    "    }",
    "",
    "    long long src, dest;",
    "    cin >> src >> dest;",
    "    dis[src] = 0;",
    "    dijkstra(src);",
    "",
    "    cout << dis[dest] << endl;",
    "",
    "    return 0;",
    "}"
  ],
  "description": ""
},
