"Eertree": {
  "prefix": "Eertree",
  "body": [
    "#include <bits/stdc++.h>",
    "using namespace std;",
    "",
    "struct Eertree",
    "{",
    "    static const long long ALPHA = 26;",
    "    struct Node",
    "    {",
    "        long long next[ALPHA], len, link, occ, firstPos;",
    "        Node(long long l = 0) : len(l), link(0), occ(0), firstPos(-1)",
    "        {",
    "            memset(next, -1, sizeof(next));",
    "        }",
    "    };",
    "    string s;",
    "    vector<Node> t;",
    "    long long suff, bestNode;",
    "",
    "    Eertree()",
    "    {",
    "        t.emplace_back(-1);",
    "        t.emplace_back(0);",
    "        t[0].link = 0;",
    "        t[1].link = 0;",
    "        suff = 1;",
    "        bestNode = 1;",
    "    }",
    "",
    "    void add(long long c)",
    "    {",
    "        s.push_back(char('a' + c));",
    "        long long cur = suff, n = (long long)s.size();",
    "        while (true)",
    "        {",
    "            long long l = t[cur].len, pos = n - 2 - l;",
    "            if (pos >= 0 && s[pos] == char('a' + c))",
    "                break;",
    "            cur = t[cur].link;",
    "        }",
    "        if (t[cur].next[c] != -1)",
    "        {",
    "            suff = t[cur].next[c];",
    "            t[suff].occ++;",
    "            if (t[suff].len > t[bestNode].len)",
    "                bestNode = suff;",
    "            return;",
    "        }",
    "        long long now = (long long)t.size();",
    "        t.emplace_back(t[cur].len + 2);",
    "        t[cur].next[c] = now;",
    "        t[now].firstPos = n - 1;",
    "        if (t[now].len == 1)",
    "        {",
    "            t[now].link = 1;",
    "        }",
    "        else",
    "        {",
    "            long long link = t[cur].link;",
    "            while (true)",
    "            {",
    "                long long l = t[link].len, pos = n - 2 - l;",
    "                if (pos >= 0 && s[pos] == char('a' + c))",
    "                    break;",
    "                link = t[link].link;",
    "            }",
    "            t[now].link = t[link].next[c];",
    "        }",
    "        t[now].occ = 1;",
    "        suff = now;",
    "        if (t[now].len > t[bestNode].len)",
    "            bestNode = now;",
    "    }",
    "",
    "    void propagate()",
    "    {",
    "        for (long long i = (long long)t.size() - 1; i >= 2; i--)",
    "            if (t[i].link >= 2)",
    "                t[t[i].link].occ += t[i].occ;",
    "    }",
    "",
    "    long long distinct() const { return (long long)t.size() - 2; }",
    "    long long longestLen() const { return t[bestNode].len; }",
    "    string longestStr() const",
    "    {",
    "        if (t[bestNode].len == 0)",
    "            return \"\";",
    "        long long e = t[bestNode].firstPos, l = t[bestNode].len;",
    "        return s.substr(e - l + 1, l);",
    "    }",
    "",
    "    long long findNode(const string &p)",
    "    {",
    "        long long n = (long long)p.size();",
    "        if (n == 0)",
    "            return 1;",
    "        long long cur = (n & 1) ? 0 : 1, l = 0, r = n - 1;",
    "        while (l <= r)",
    "        {",
    "            long long c = p[l] - 'a';",
    "            if (c < 0 || c >= ALPHA || t[cur].next[c] == -1)",
    "                return -1;",
    "            cur = t[cur].next[c];",
    "            l++;",
    "            r--;",
    "        }",
    "        return cur;",
    "    }",
    "",
    "    long long countOf(const string &p)",
    "    {",
    "        long long id = findNode(p);",
    "        return id == -1 ? 0 : t[id].occ;",
    "    }",
    "",
    "    long long totalSubstrings() const",
    "    {",
    "        long long r = 0;",
    "        for (long long i = 2; i < (long long)t.size(); i++)",
    "            r += t[i].occ;",
    "        return r;",
    "    }",
    "};",
    "",
    "signed main()",
    "{",
    "    ios::sync_with_stdio(false);",
    "    cin.tie(nullptr);",
    "",
    "    string s;",
    "    cin >> s;",
    "",
    "    Eertree et;",
    "    for (char ch : s)",
    "        et.add(ch - 'a');",
    "    et.propagate();",
    "",
    "    cout << et.distinct() << endl;",
    "    cout << et.longestLen() << endl;",
    "    cout << et.longestStr() << endl;",
    "    cout << et.totalSubstrings() << endl;",
    "    cout << et.countOf(\"aba\") << endl;",
    "",
    "    for (long long i = 2; i < (long long)et.t.size(); i++)",
    "    {",
    "        long long l = et.t[i].len, e = et.t[i].firstPos;",
    "        cout << et.s.substr(e - l + 1, l) << ' ' << et.t[i].occ << endl;",
    "    }",
    "    $0",
    "}"
  ],
  "description": ""
},
"AhoCorasick": {
  "prefix": "AhoCorasick",
  "body": [
    "#include <bits/stdc++.h>",
    "using namespace std;",
    "",
    "struct AhoCorasick",
    "{",
    "    struct Node",
    "    {",
    "        long long children[26], go[26], fail;",
    "        long long patternCount;",
    "",
    "        Node()",
    "        {",
    "            memset(children, -1, sizeof(children));",
    "            memset(go, -1, sizeof(go));",
    "            fail = -1;",
    "            patternCount = 0;",
    "        }",
    "    };",
    "",
    "    vector<Node> nodes;",
    "    long long root;",
    "",
    "    AhoCorasick()",
    "    {",
    "        root = 0;",
    "        nodes.push_back(Node());",
    "    }",
    "",
    "    long long charToIndex(char c) const",
    "    {",
    "        return c - 'a';",
    "    }",
    "",
    "    // Insert a pattern into the trie",
    "    void insert(const string &s, long long id = 0)",
    "    {",
    "        long long curr = root;",
    "        for (char c : s)",
    "        {",
    "            long long i = charToIndex(c);",
    "            if (nodes[curr].children[i] == -1)",
    "            {",
    "                nodes[curr].children[i] = (long long)nodes.size();",
    "                nodes.push_back(Node());",
    "            }",
    "            curr = nodes[curr].children[i];",
    "        }",
    "        nodes[curr].patternCount++;",
    "    }",
    "",
    "    // Build failure links, goto function, and propagate pattern counts (BFS)",
    "    void build()",
    "    {",
    "        queue<long long> q;",
    "        nodes[root].fail = root;",
    "",
    "        for (long long i = 0; i < 26; ++i)",
    "        {",
    "            if (nodes[root].children[i] != -1)",
    "            {",
    "                long long child = nodes[root].children[i];",
    "                nodes[child].fail = root;",
    "                q.push(child);",
    "                nodes[root].go[i] = child;",
    "            }",
    "            else",
    "            {",
    "                nodes[root].go[i] = root;",
    "            }",
    "        }",
    "",
    "        while (!q.empty())",
    "        {",
    "            long long curr = q.front();",
    "            q.pop();",
    "",
    "            for (long long i = 0; i < 26; ++i)",
    "            {",
    "                long long child = nodes[curr].children[i];",
    "                if (child != -1)",
    "                {",
    "                    long long fail = nodes[curr].fail;",
    "                    while (fail != root && nodes[fail].children[i] == -1)",
    "                        fail = nodes[fail].fail;",
    "",
    "                    if (nodes[fail].children[i] != -1)",
    "                        fail = nodes[fail].children[i];",
    "                    else",
    "                        fail = root;",
    "",
    "                    nodes[child].fail = fail;",
    "                    nodes[child].patternCount += nodes[fail].patternCount;",
    "",
    "                    q.push(child);",
    "                    nodes[curr].go[i] = child;",
    "                }",
    "                else",
    "                {",
    "                    nodes[curr].go[i] = nodes[nodes[curr].fail].go[i];",
    "                }",
    "            }",
    "        }",
    "    }",
    "",
    "    // For each position j in text: out[j] = #patterns ending at position j",
    "    void countEndingAt(const string &text, vector<long long> &out) const",
    "    {",
    "        out.assign(text.size(), 0);",
    "        long long curr = root;",
    "        for (long long j = 0; j < (long long)text.size(); ++j)",
    "        {",
    "            long long i = charToIndex(text[j]);",
    "            curr = nodes[curr].go[i];",
    "            out[j] = nodes[curr].patternCount;",
    "        }",
    "    }",
    "",
    "    // Total occurrences of all patterns in text",
    "    long long countTotal(const string &text) const",
    "    {",
    "        vector<long long> out;",
    "        countEndingAt(text, out);",
    "        long long total = 0;",
    "        for (long long x : out) total += x;",
    "        return total;",
    "    }",
    "",
    "    // Does text contain any pattern?",
    "    bool containsAny(const string &text) const",
    "    {",
    "        long long curr = root;",
    "        for (char c : text)",
    "        {",
    "            curr = nodes[curr].go[charToIndex(c)];",
    "            if (nodes[curr].patternCount > 0) return true;",
    "        }",
    "        return false;",
    "    }",
    "};",
    "signed main()",
    "{",
    "    ios::sync_with_stdio(false);",
    "    cin.tie(nullptr);",
    "",
    "    long long n;",
    "    cin >> n;",
    "",
    "    AhoCorasick ac;",
    "    for (long long i = 0; i < n; ++i)",
    "    {",
    "        string s;",
    "        cin >> s;",
    "        ac.insert(s);",
    "    }",
    "    ac.build();",
    "",
    "    string text;",
    "    cin >> text;",
    "",
    "    vector<long long> ends;",
    "    ac.countEndingAt(text, ends);",
    "",
    "    long long total = ac.countTotal(text);",
    "    bool any = ac.containsAny(text);",
    "",
    "    cout << \"Total: \" << total << endl;",
    "    cout << \"Any pattern? \" << (any ? \"Yes\" : \"No\") << endl;",
    "    $0",
    "    return 0;",
    "}"
  ],
  "description": ""
},
"SuffixArray": {
  "prefix": "SuffixArray",
  "body": [
    "#include <bits/stdc++.h>",
    "using namespace std;",
    "",
    "struct SuffixArray",
    "{",
    "    string s;",
    "    long long n;",
    "    vector<long long> sa, rank_arr, lcp, lg;",
    "    vector<vector<long long>> st;",
    "",
    "    // Constructor: builds SA, LCP, and RMQ sparse table",
    "    SuffixArray(const string &str)",
    "    {",
    "        s = str, n = s.size();",
    "        sa.assign(n, 0);",
    "        rank_arr.assign(n, 0);",
    "        build_sa();",
    "        build_lcp();",
    "        build_rmq();",
    "    }",
    "",
    "    // Build suffix array in O(n log n) using prefix doubling",
    "    void build_sa()",
    "    {",
    "        vector<long long> rnk(n), cnt;",
    "        long long alphabet = 256;",
    "        cnt.assign(alphabet, 0);",
    "        for (long long i = 0; i < n; i++)",
    "            cnt[(unsigned char)s[i]]++;",
    "        for (long long i = 1; i < alphabet; i++)",
    "            cnt[i] += cnt[i - 1];",
    "        for (long long i = n - 1; i >= 0; i--)",
    "        {",
    "            unsigned char c = (unsigned char)s[i];",
    "            cnt[c]--, sa[cnt[c]] = i;",
    "        }",
    "        long long classes = 1;",
    "        rnk[sa[0]] = 0;",
    "        for (long long i = 1; i < n; i++)",
    "        {",
    "            if (s[sa[i]] != s[sa[i - 1]])",
    "                classes++;",
    "            rnk[sa[i]] = classes - 1;",
    "        }",
    "        for (long long h = 1; h < n && classes < n; h <<= 1)",
    "        {",
    "            cnt.assign(classes + 1, 0);",
    "            for (long long i = 0; i < n; i++)",
    "            {",
    "                long long idx = sa[i];",
    "                long long key = (idx + h < n ? rnk[idx + h] + 1 : 0);",
    "                cnt[key]++;",
    "            }",
    "            for (long long i = 1; i < (long long)cnt.size(); i++)",
    "                cnt[i] += cnt[i - 1];",
    "            vector<long long> sa2(n);",
    "            for (long long i = n - 1; i >= 0; i--)",
    "            {",
    "                long long idx = sa[i];",
    "                long long key = (idx + h < n ? rnk[idx + h] + 1 : 0);",
    "                cnt[key]--;",
    "                sa2[cnt[key]] = idx;",
    "            }",
    "            cnt.assign(classes, 0);",
    "            for (long long i = 0; i < n; i++)",
    "                cnt[rnk[sa2[i]]]++;",
    "            for (long long i = 1; i < classes; i++)",
    "                cnt[i] += cnt[i - 1];",
    "            for (long long i = n - 1; i >= 0; i--)",
    "            {",
    "                long long idx = sa2[i];",
    "                long long key = rnk[idx];",
    "                cnt[key]--, sa[cnt[key]] = idx;",
    "            }",
    "            vector<long long> rnk2(n);",
    "            rnk2[sa[0]] = 0, classes = 1;",
    "            for (long long i = 1; i < n; i++)",
    "            {",
    "                long long cur = sa[i], prev = sa[i - 1];",
    "                long long mid = (cur + h < n ? rnk[cur + h] : -1);",
    "                long long mid_prev = (prev + h < n ? rnk[prev + h] : -1);",
    "                if (rnk[cur] != rnk[prev] || mid != mid_prev)",
    "                    classes++;",
    "                rnk2[cur] = classes - 1;",
    "            }",
    "            rnk = move(rnk2);",
    "        }",
    "        rank_arr = move(rnk);",
    "    }",
    "",
    "    // Build LCP array in O(n) using Kasai's algorithm",
    "    void build_lcp()",
    "    {",
    "        lcp.assign(n, 0);",
    "        long long h = 0;",
    "        for (long long i = 0; i < n; i++)",
    "        {",
    "            long long r = rank_arr[i];",
    "            if (r == 0)",
    "            {",
    "                lcp[r] = 0;",
    "                continue;",
    "            }",
    "            long long j = sa[r - 1];",
    "            while (i + h < n && j + h < n && s[i + h] == s[j + h])",
    "                h++;",
    "            lcp[r] = h;",
    "            if (h > 0)",
    "                h--;",
    "        }",
    "    }",
    "",
    "    // Build sparse table over LCP for O(1) range-min queries",
    "    void build_rmq()",
    "    {",
    "        long long m = n;",
    "        lg.assign(m + 1, 0);",
    "        for (long long i = 2; i <= m; i++)",
    "            lg[i] = lg[i / 2] + 1;",
    "        long long K = lg[m] + 1;",
    "        st.assign(K, vector<long long>(m));",
    "        for (long long i = 0; i < m; i++)",
    "            st[0][i] = lcp[i];",
    "        for (long long k = 1; k < K; k++)",
    "        {",
    "            long long len = 1 << k;",
    "            long long half = 1 << (k - 1);",
    "            for (long long i = 0; i + len <= m; i++)",
    "                st[k][i] = min(st[k - 1][i], st[k - 1][i + half]);",
    "        }",
    "    }",
    "",
    "    // LCP of suffixes starting at i and j in O(1)",
    "    long long get_lcp(long long i, long long j) const",
    "    {",
    "        if (i == j)",
    "            return n - i;",
    "        long long ri = rank_arr[i], rj = rank_arr[j];",
    "        if (ri > rj)",
    "            swap(ri, rj);",
    "        long long L = ri + 1, R = rj;",
    "        long long len = R - L + 1;",
    "        long long k = lg[len];",
    "        return min(st[k][L], st[k][R - (1 << k) + 1]);",
    "    }",
    "",
    "    // Count distinct substrings in O(n)",
    "    long long count_distinct_substrings() const",
    "    {",
    "        long long total = (long long)n * (n + 1) / 2;",
    "        long long sum = 0;",
    "        for (long long i = 1; i < n; i++)",
    "            sum += lcp[i];",
    "        return total - sum;",
    "    }",
    "",
    "    // Return the k-th lexicographically smallest distinct substring",
    "    string kth_substring(long long k) const",
    "    {",
    "        for (long long i = 0; i < n; i++)",
    "        {",
    "            long long suffix_len = n - sa[i];",
    "            long long common = (i > 0 ? (long long)lcp[i] : 0LL);",
    "            long long new_sub = suffix_len - common;",
    "            if (k <= new_sub)",
    "                return s.substr(sa[i], (size_t)(common + k));",
    "            k -= new_sub;",
    "        }",
    "        return \"\";",
    "    }",
    "",
    "    // Check if pattern t occurs in s using binary search, O(m log n)",
    "    bool substring_search(const string &t) const",
    "    {",
    "        long long m = t.size();",
    "        long long l = 0, r = n - 1;",
    "        while (l <= r)",
    "        {",
    "            long long mid = (l + r) >> 1;",
    "            long long start = sa[mid];",
    "            long long cmp = 0;",
    "            for (long long k = 0; k < m; k++)",
    "            {",
    "                if (start + k >= n)",
    "                {",
    "                    cmp = -1;",
    "                    break;",
    "                }",
    "                if (s[start + k] < t[k])",
    "                {",
    "                    cmp = -1;",
    "                    break;",
    "                }",
    "                if (s[start + k] > t[k])",
    "                {",
    "                    cmp = 1;",
    "                    break;",
    "                }",
    "            }",
    "            if (cmp == 0)",
    "                return true;",
    "            if (cmp < 0)",
    "                l = mid + 1;",
    "            else",
    "                r = mid - 1;",
    "        }",
    "        return false;",
    "    }",
    "",
    "    // Compare two substrings [l1, r1] and [l2, r2], returns -1, 0, 1",
    "    long long compare_substrings(long long l1, long long r1, long long l2, long long r2) const",
    "    {",
    "        long long len1 = r1 - l1 + 1;",
    "        long long len2 = r2 - l2 + 1;",
    "        long long common = get_lcp(l1, l2);",
    "        if (common >= min(len1, len2))",
    "        {",
    "            if (len1 == len2)",
    "                return 0;",
    "            return (len1 < len2) ? -1 : 1;",
    "        }",
    "        char c1 = s[l1 + common];",
    "        char c2 = s[l2 + common];",
    "        return (c1 < c2) ? -1 : 1;",
    "    }",
    "",
    "    // Longest palindromic substring using SA on s + '#' + reverse(s)",
    "    string longest_palindromic_substring() const",
    "    {",
    "        string rs = s;",
    "        reverse(rs.begin(), rs.end());",
    "        string comb = s + '#' + rs;",
    "        SuffixArray sa2(comb);",
    "        long long n1 = n;",
    "        long long best_len = 0, best_pos = 0;",
    "        for (long long i = 0; i < n1; i++)",
    "        {",
    "            long long l1 = i, l2 = n1 + 1 + (n1 - 1 - i);",
    "            long long common = sa2.get_lcp(l1, l2);",
    "            long long len_odd = 2 * common - 1;",
    "            if (common > 0 && len_odd > best_len)",
    "            {",
    "                best_len = len_odd;",
    "                best_pos = i - common + 1;",
    "            }",
    "        }",
    "        for (long long i = 1; i < n1; i++)",
    "        {",
    "            long long l1 = i;",
    "            long long l2 = n1 + 1 + (n1 - i);",
    "            long long common = sa2.get_lcp(l1, l2);",
    "            long long len_even = 2 * common;",
    "            if (common > 0 && len_even > best_len)",
    "            {",
    "                best_len = len_even;",
    "                best_pos = i - common;",
    "            }",
    "        }",
    "        if (best_len <= 0)",
    "            return s.substr(0, 1);",
    "        return s.substr(best_pos, best_len);",
    "    }",
    "",
    "    // Longest common substring between s and t, returns {length, substring}",
    "    pair<long long, string> longest_common_substring(const string &t) const",
    "    {",
    "        string comb = s + '#' + t;",
    "        long long n1 = n;",
    "        SuffixArray sa2(comb);",
    "        long long totalN = comb.size();",
    "        long long best_lcp = 0, best_pos = 0;",
    "        for (long long i = 1; i < totalN; i++)",
    "        {",
    "            long long p = sa2.sa[i - 1];",
    "            long long q = sa2.sa[i];",
    "            bool in1 = (p < n1);",
    "            bool in2 = (q > n1);",
    "            if (in1 && in2)",
    "            {",
    "                long long cur = sa2.lcp[i];",
    "                if (cur > best_lcp)",
    "                {",
    "                    best_lcp = cur;",
    "                    best_pos = sa2.sa[i];",
    "                }",
    "            }",
    "            else if ((q < n1) && (p > n1))",
    "            {",
    "                long long cur = sa2.lcp[i];",
    "                if (cur > best_lcp)",
    "                {",
    "                    best_lcp = cur;",
    "                    best_pos = sa2.sa[i - 1];",
    "                }",
    "            }",
    "        }",
    "        if (best_lcp == 0)",
    "            return {0, \"\"};",
    "        return {best_lcp, comb.substr(best_pos, best_lcp)};",
    "    }",
    "",
    "    // Longest substring that occurs at least k times (k >= 2)",
    "    // Returns {length, substring}; if none exists, returns {0, \"\"}",
    "    pair<long long, string> longest_substring_k_times(long long k) const",
    "    {",
    "        if (k <= 1)",
    "        {",
    "            return {(long long)n, s};",
    "        }",
    "        if (k > n)",
    "            return {0, \"\"};",
    "",
    "        long long best_len = 0;",
    "        long long best_pos = 0;",
    "",
    "        deque<long long> dq;",
    "",
    "        for (long long i = 1; i < n; i++)",
    "        {",
    "            while (!dq.empty() && lcp[dq.back()] >= lcp[i])",
    "                dq.pop_back();",
    "            dq.push_back(i);",
    "",
    "            long long window_start = i - k + 2;",
    "            while (!dq.empty() && dq.front() < window_start)",
    "                dq.pop_front();",
    "",
    "            if (i >= k - 1)",
    "            {",
    "                long long cur = lcp[dq.front()];",
    "                if (cur > best_len)",
    "                {",
    "                    best_len = cur;",
    "                    best_pos = sa[i - k + 1];",
    "                }",
    "            }",
    "        }",
    "",
    "        if (best_len == 0)",
    "            return {0, \"\"};",
    "        return {best_len, s.substr(best_pos, best_len)};",
    "    }",
    "};",
    "",
    "signed main()",
    "{",
    "    ios::sync_with_stdio(false);",
    "    cin.tie(nullptr);",
    "",
    "    string s;",
    "    cin >> s;",
    "",
    "    SuffixArray sa(s);",
    "",
    "    $0",
    "    return 0;",
    "}"
  ],
  "description": ""
},
"SuffixAutomaton": {
  "prefix": "SuffixAutomaton",
  "body": [
    "#include <bits/stdc++.h>",
    "using namespace std;",
    "",
    "const int N = 3e5 + 9;",
    "",
    "// len -> largest string length of the corresponding endpos-equivalent class",
    "// link -> longest suffix that is another endpos-equivalent class.",
    "// firstpos -> 1 indexed end position of the first occurrence of the largest string of that node",
    "// minlen(v) -> smallest string of node v = len(link(v)) + 1",
    "// terminal nodes -> store the suffixes",
    "struct SuffixAutomaton",
    "{",
    "    struct node",
    "    {",
    "        int len, link, firstpos;",
    "        map<char, int> nxt;",
    "    };",
    "    int sz, last;",
    "    vector<node> t;",
    "    vector<int> terminal;",
    "    vector<long long> dp;",
    "    vector<vector<int>> g;",
    "    SuffixAutomaton() {}",
    "    SuffixAutomaton(int n)",
    "    {",
    "        t.resize(2 * n);",
    "        terminal.resize(2 * n, 0);",
    "        dp.resize(2 * n, -1);",
    "        sz = 1;",
    "        last = 0;",
    "        g.resize(2 * n);",
    "        t[0].len = 0;",
    "        t[0].link = -1;",
    "        t[0].firstpos = 0;",
    "    }",
    "    void extend(char c)",
    "    {",
    "        int p = last;",
    "        if (t[p].nxt.count(c))",
    "        {",
    "            int q = t[p].nxt[c];",
    "            if (t[q].len == t[p].len + 1)",
    "            {",
    "                last = q;",
    "                return;",
    "            }",
    "            int clone = sz++;",
    "            t[clone] = t[q];",
    "            t[clone].len = t[p].len + 1;",
    "            t[q].link = clone;",
    "            last = clone;",
    "            while (p != -1 && t[p].nxt[c] == q)",
    "            {",
    "                t[p].nxt[c] = clone;",
    "                p = t[p].link;",
    "            }",
    "            return;",
    "        }",
    "        int cur = sz++;",
    "        t[cur].len = t[last].len + 1;",
    "        t[cur].firstpos = t[cur].len;",
    "        p = last;",
    "        while (p != -1 && !t[p].nxt.count(c))",
    "        {",
    "            t[p].nxt[c] = cur;",
    "            p = t[p].link;",
    "        }",
    "        if (p == -1)",
    "            t[cur].link = 0;",
    "        else",
    "        {",
    "            int q = t[p].nxt[c];",
    "            if (t[p].len + 1 == t[q].len)",
    "                t[cur].link = q;",
    "            else",
    "            {",
    "                int clone = sz++;",
    "                t[clone] = t[q];",
    "                t[clone].len = t[p].len + 1;",
    "                while (p != -1 && t[p].nxt[c] == q)",
    "                {",
    "                    t[p].nxt[c] = clone;",
    "                    p = t[p].link;",
    "                }",
    "                t[q].link = t[cur].link = clone;",
    "            }",
    "        }",
    "        last = cur;",
    "    }",
    "    void build_tree()",
    "    {",
    "        for (int i = 1; i < sz; i++)",
    "            g[t[i].link].push_back(i);",
    "    }",
    "    void build(string &s)",
    "    {",
    "        for (auto x : s)",
    "        {",
    "            extend(x);",
    "            terminal[last] = 1;",
    "        }",
    "        build_tree();",
    "    }",
    "    long long cnt(int i)",
    "    { // number of times i-th node occurs in the string",
    "        if (dp[i] != -1)",
    "            return dp[i];",
    "        long long ret = terminal[i];",
    "        for (auto &x : g[i])",
    "            ret += cnt(x);",
    "        return dp[i] = ret;",
    "    }",
    "};",
    "",
    "signed main()",
    "{",
    "    ios_base::sync_with_stdio(0);",
    "    cin.tie(0);",
    "    int t;",
    "    cin >> t;",
    "    while (t--)",
    "    {",
    "        string s;",
    "        cin >> s;",
    "        int n = s.size();",
    "        SuffixAutomaton sa(n);",
    "        sa.build(s);",
    "        long long ans = 0; // number of unique substrings",
    "        for (int i = 1; i < sa.sz; i++)",
    "        {",
    "            ans += sa.t[i].len - sa.t[sa.t[i].link].len;",
    "        }",
    "        cout << ans << endl;",
    "        $0",
    "    }",
    "    return 0;",
    "}",
    ""
  ],
  "description": ""
},
"scc_kosaraju": {
  "prefix": "scc_kosaraju",
  "body": [
    "#include <bits/stdc++.h>",
    "using namespace std;",
    "",
    "signed main()",
    "{",
    "    ios::sync_with_stdio(false);",
    "    cin.tie(nullptr);",
    "",
    "    long long n, m;",
    "    cin >> n >> m;",
    "",
    "    vector<vector<long long>> adj(n);",
    "    for (long long i = 0; i < m; i++)",
    "    {",
    "        long long u, v;",
    "        cin >> u >> v;",
    "        --u;",
    "        --v;",
    "        adj[u].push_back(v);",
    "    }",
    "",
    "    vector<bool> visited(n, false);",
    "    vector<long long> order;",
    "",
    "    auto dfs1 = [&](auto &&self, long long v) -> void",
    "    {",
    "        visited[v] = true;",
    "        for (auto u : adj[v])",
    "        {",
    "            if (!visited[u])",
    "            {",
    "                self(self, u);",
    "            }",
    "        }",
    "        order.push_back(v);",
    "    };",
    "",
    "    for (long long i = 0; i < n; i++)",
    "    {",
    "        if (!visited[i])",
    "        {",
    "            dfs1(dfs1, i);",
    "        }",
    "    }",
    "",
    "    vector<vector<long long>> adj_rev(n);",
    "    for (long long v = 0; v < n; v++)",
    "    {",
    "        for (auto u : adj[v])",
    "        {",
    "            adj_rev[u].push_back(v);",
    "        }",
    "    }",
    "",
    "    fill(visited.begin(), visited.end(), false);",
    "    reverse(order.begin(), order.end());",
    "",
    "    vector<long long> roots(n, 0);",
    "    vector<vector<long long>> components;",
    "",
    "    auto dfs2 = [&](auto &&self, long long v, vector<long long> &comp) -> void",
    "    {",
    "        visited[v] = true;",
    "        comp.push_back(v);",
    "        for (auto u : adj_rev[v])",
    "        {",
    "            if (!visited[u])",
    "            {",
    "                self(self, u, comp);",
    "            }",
    "        }",
    "    };",
    "",
    "    for (auto v : order)",
    "    {",
    "        if (!visited[v])",
    "        {",
    "            vector<long long> component;",
    "            dfs2(dfs2, v, component);",
    "            components.push_back(component);",
    "",
    "            long long root = component.front();",
    "            for (auto u : component)",
    "            {",
    "                roots[u] = root;",
    "            }",
    "        }",
    "    }",
    "",
    "    vector<vector<long long>> adj_cond(n);",
    "    for (long long v = 0; v < n; v++)",
    "    {",
    "        for (auto u : adj[v])",
    "        {",
    "            if (roots[v] != roots[u])",
    "            {",
    "                adj_cond[roots[v]].push_back(roots[u]);",
    "            }",
    "        }",
    "    }",
    "",
    "    cout << components.size() << endl;",
    "    for (auto &c : components)",
    "    {",
    "        for (long long v : c)",
    "        {",
    "            cout << v + 1 << ' ';",
    "        }",
    "        cout << endl;",
    "    }",
    "    $0",
    "    return 0;",
    "}"
  ],
  "description": ""
},
"tarjans_articulation_point_and_bridge": {
  "prefix": "tarjans_articulation_point_and_bridge",
  "body": [
    "#include <bits/stdc++.h>",
    "using namespace std;",
    "",
    "const long long MAXN = 3e5 + 5;",
    "",
    "long long n, m;",
    "vector<long long> adj[MAXN];",
    "long long disc[MAXN], low[MAXN], timer;",
    "bool isArt[MAXN];",
    "vector<pair<long long, long long>> bridges;",
    "",
    "void dfsAP(long long u, long long p)",
    "{",
    "    disc[u] = low[u] = ++timer;",
    "    long long child = 0;",
    "",
    "    for (long long v : adj[u])",
    "    {",
    "        if (v == p)",
    "            continue;",
    "",
    "        if (!disc[v])",
    "        {",
    "            child++;",
    "            dfsAP(v, u);",
    "            low[u] = min(low[u], low[v]);",
    "",
    "            if (disc[u] <= low[v])",
    "            {",
    "                isArt[u] = true;",
    "            }",
    "        }",
    "        else",
    "        {",
    "            low[u] = min(low[u], disc[v]);",
    "        }",
    "    }",
    "",
    "    if (p == u && child < 2)",
    "    {",
    "        isArt[u] = false;",
    "    }",
    "}",
    "",
    "void findArticulationPoint()",
    "{",
    "    timer = 0;",
    "    fill(disc, disc + n + 1, 0);",
    "    fill(low, low + n + 1, 0);",
    "    fill(isArt, isArt + n + 1, false);",
    "",
    "    for (long long u = 1; u <= n; u++)",
    "    {",
    "        if (!disc[u])",
    "        {",
    "            dfsAP(u, u);",
    "        }",
    "    }",
    "}",
    "",
    "void dfsBR(long long u, long long p)",
    "{",
    "    disc[u] = low[u] = ++timer;",
    "",
    "    for (long long v : adj[u])",
    "    {",
    "        if (v == p)",
    "            continue;",
    "",
    "        if (!disc[v])",
    "        {",
    "            dfsBR(v, u);",
    "            low[u] = min(low[u], low[v]);",
    "",
    "            if (disc[u] < low[v])",
    "            {",
    "                bridges.push_back({u, v});",
    "            }",
    "        }",
    "        else",
    "        {",
    "            low[u] = min(low[u], disc[v]);",
    "        }",
    "    }",
    "}",
    "",
    "void findBridges()",
    "{",
    "    timer = 0;",
    "    fill(disc, disc + n + 1, 0);",
    "    fill(low, low + n + 1, 0);",
    "    bridges.clear();",
    "",
    "    for (long long u = 1; u <= n; u++)",
    "    {",
    "        if (!disc[u])",
    "        {",
    "            dfsBR(u, u);",
    "        }",
    "    }",
    "}",
    "// O(V+E)",
    "",
    "signed main()",
    "{",
    "    ios::sync_with_stdio(false);",
    "    cin.tie(nullptr);",
    "",
    "    cin >> n >> m;",
    "",
    "    for (long long i = 0; i < m; i++)",
    "    {",
    "        long long u, v;",
    "        cin >> u >> v;",
    "        adj[u].push_back(v);",
    "        adj[v].push_back(u);",
    "    }",
    "",
    "    findArticulationPoint();",
    "    findBridges();",
    "",
    "    $0",
    "    return 0;",
    "}"
  ],
  "description": ""
},
"scc_tarjan's": {
  "prefix": "scc_tarjan's",
  "body": [
    "#include <bits/stdc++.h>",
    "using namespace std;",
    "",
    "const long long MAXN = 100005;",
    "",
    "long long n, m;",
    "vector<long long> adj[MAXN];",
    "",
    "long long t_in[MAXN], t_low[MAXN], timer;",
    "long long roots[MAXN];",
    "vector<long long> stk;",
    "",
    "vector<vector<long long>> components;",
    "vector<long long> adj_cond[MAXN];",
    "",
    "void dfs(long long v)",
    "{",
    "    t_in[v] = t_low[v] = ++timer;",
    "    stk.push_back(v);",
    "",
    "    for (long long u : adj[v])",
    "    {",
    "        if (t_in[u] == 0)",
    "        {",
    "            dfs(u);",
    "            t_low[v] = min(t_low[v], t_low[u]);",
    "        }",
    "        else if (roots[u] == -1)",
    "        {",
    "            t_low[v] = min(t_low[v], t_in[u]);",
    "        }",
    "    }",
    "",
    "    if (t_low[v] == t_in[v])",
    "    {",
    "        components.push_back({v});",
    "",
    "        while (true)",
    "        {",
    "            long long u = stk.back();",
    "            stk.pop_back();",
    "            roots[u] = v;",
    "",
    "            if (u == v)",
    "            {",
    "                break;",
    "            }",
    "",
    "            components.back().push_back(u);",
    "        }",
    "    }",
    "}",
    "",
    "void findSCCs()",
    "{",
    "    timer = 0;",
    "    fill(t_in, t_in + n + 1, 0);",
    "    fill(t_low, t_low + n + 1, 0);",
    "    fill(roots, roots + n + 1, -1);",
    "",
    "    stk.clear();",
    "    components.clear();",
    "",
    "    for (long long v = 1; v <= n; v++)",
    "    {",
    "        if (!t_in[v])",
    "        {",
    "            dfs(v);",
    "        }",
    "    }",
    "",
    "    for (long long v = 1; v <= n; v++)",
    "    {",
    "        adj_cond[v].clear();",
    "    }",
    "",
    "    for (long long v = 1; v <= n; v++)",
    "    {",
    "        for (long long u : adj[v])",
    "        {",
    "            if (roots[v] != roots[u])",
    "            {",
    "                adj_cond[roots[v]].push_back(roots[u]);",
    "            }",
    "        }",
    "    }",
    "}",
    "",
    "signed main()",
    "{",
    "    ios::sync_with_stdio(false);",
    "    cin.tie(nullptr);",
    "",
    "    cin >> n >> m;",
    "",
    "    for (long long i = 0; i < m; i++)",
    "    {",
    "        long long u, v;",
    "        cin >> u >> v;",
    "        adj[u].push_back(v);",
    "    }",
    "",
    "    findSCCs();",
    "",
    "    cout << \"Number of SCCs: \" << components.size() << '\\n';",
    "",
    "    for (long long i = 0; i < (long long)components.size(); i++)",
    "    {",
    "        cout << \"SCC #\" << i << \": \";",
    "",
    "        for (long long u : components[i])",
    "        {",
    "            cout << u << ' ';",
    "        }",
    "",
    "        cout << '\\n';",
    "    }",
    "",
    "    cout << \"\\nCondensation DAG edges:\\n\";",
    "",
    "    for (long long v = 1; v <= n; v++)",
    "    {",
    "        if (roots[v] == v)",
    "        {",
    "            for (long long u : adj_cond[v])",
    "            {",
    "                cout << v << \" -> \" << u << '\\n';",
    "            }",
    "        }",
    "    }",
    "    $0",
    "    return 0;",
    "}"
  ],
  "description": ""
},
"lca": {
  "prefix": "lca",
  "body": [
    "#include <bits/stdc++.h>",
    "using namespace std;",
    "",
    "struct LCA",
    "{",
    "    long long n, LOG, root;",
    "    vector<vector<long long>> adj;",
    "    vector<vector<long long>> up;",
    "    vector<long long> par, depth, tin, tout, height, order;",
    "",
    "    LCA(long long n = 0)",
    "    {",
    "        init(n);",
    "    }",
    "",
    "    void init(long long n_)",
    "    {",
    "        n = n_;",
    "        LOG = 1;",
    "        while ((1 << LOG) <= n)",
    "        {",
    "            LOG++;",
    "        }",
    "        LOG++;",
    "        adj.assign(n + 1, {});",
    "        up.assign(n + 1, vector<long long>(LOG, 0));",
    "        par.assign(n + 1, 0);",
    "        depth.assign(n + 1, 0);",
    "        tin.assign(n + 1, 0);",
    "        tout.assign(n + 1, 0);",
    "        height.assign(n + 1, 0);",
    "        order.clear();",
    "        order.reserve(n);",
    "    }",
    "",
    "    void add_edge(long long u, long long v)",
    "    {",
    "        adj[u].push_back(v);",
    "        adj[v].push_back(u);",
    "    }",
    "",
    "    void build(long long root_)",
    "    {",
    "        root = root_;",
    "        order.clear();",
    "        long long timer = 0;",
    "        vector<long long> it(n + 1, 0), st;",
    "        st.push_back(root);",
    "        par[root] = root;",
    "        depth[root] = 0;",
    "        tin[root] = ++timer;",
    "        order.push_back(root);",
    "",
    "        while (!st.empty())",
    "        {",
    "            long long v = st.back();",
    "            if (it[v] < (long long)adj[v].size())",
    "            {",
    "                long long u = adj[v][it[v]++];",
    "                if (u == par[v])",
    "                {",
    "                    continue;",
    "                }",
    "                par[u] = v;",
    "                depth[u] = depth[v] + 1;",
    "                tin[u] = ++timer;",
    "                order.push_back(u);",
    "                st.push_back(u);",
    "            }",
    "            else",
    "            {",
    "                tout[v] = ++timer;",
    "                st.pop_back();",
    "            }",
    "        }",
    "",
    "        for (long long v : order)",
    "        {",
    "            up[v][0] = par[v];",
    "            for (long long i = 1; i < LOG; i++)",
    "            {",
    "                up[v][i] = up[up[v][i - 1]][i - 1];",
    "            }",
    "        }",
    "",
    "        fill(height.begin(), height.end(), 0);",
    "        for (long long i = n - 1; i >= 1; i--)",
    "        {",
    "            long long v = order[i];",
    "            height[par[v]] = max(height[par[v]], height[v] + 1);",
    "        }",
    "    }",
    "",
    "    bool is_ancestor(long long u, long long v) const",
    "    {",
    "        return tin[u] <= tin[v] && tout[u] >= tout[v];",
    "    }",
    "",
    "    long long kth_ancestor(long long u, long long k) const",
    "    {",
    "        k = min<long long>(k, depth[u]);",
    "        for (long long i = 0; i < LOG; i++)",
    "        {",
    "            if ((k >> i) & 1)",
    "            {",
    "                u = up[u][i];",
    "            }",
    "        }",
    "        return u;",
    "    }",
    "",
    "    long long lca(long long u, long long v) const",
    "    {",
    "        if (is_ancestor(u, v))",
    "        {",
    "            return u;",
    "        }",
    "        if (is_ancestor(v, u))",
    "        {",
    "            return v;",
    "        }",
    "        for (long long i = LOG - 1; i >= 0; i--)",
    "        {",
    "            if (!is_ancestor(up[u][i], v))",
    "            {",
    "                u = up[u][i];",
    "            }",
    "        }",
    "        return up[u][0];",
    "    }",
    "",
    "    long long distance(long long u, long long v) const",
    "    {",
    "        return depth[u] + depth[v] - 2LL * depth[lca(u, v)];",
    "    }",
    "",
    "    long long kth_on_path(long long u, long long v, long long k) const",
    "    {",
    "        long long w = lca(u, v);",
    "        long long du = depth[u] - depth[w];",
    "        if (k <= du)",
    "        {",
    "            return kth_ancestor(u, k);",
    "        }",
    "        long long dv = depth[v] - depth[w];",
    "        return kth_ancestor(v, dv - (k - du));",
    "    }",
    "",
    "    // size of subtree rooted at v",
    "    long long subtree_size(long long v) const",
    "    {",
    "        return (tout[v] - tin[v] + 1) / 2;",
    "    }",
    "};",
    "",
    "signed main()",
    "{",
    "    ios::sync_with_stdio(false);",
    "    cin.tie(nullptr);",
    "",
    "    long long n, q;",
    "    cin >> n >> q;",
    "",
    "    LCA tree(n);",
    "",
    "    for (long long i = 0; i < n - 1; i++)",
    "    {",
    "        long long u, v;",
    "        cin >> u >> v;",
    "        tree.add_edge(u, v);",
    "    }",
    "",
    "    tree.build(1);",
    "",
    "    while (q--)",
    "    {",
    "        long long u, v;",
    "        cin >> u >> v;",
    "        cout << tree.lca(u, v) << endl;",
    "    }",
    "    $0",
    "    return 0;",
    "}"
