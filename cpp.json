},
"LinearBasis_xor_space": {
  "prefix": "LinearBasis_xor_space",
  "body": [
    "#include <bits/stdc++.h>",
    "using namespace std;",
    "",
    "struct LinearBasis",
    "{",
    "    static const long long LOG = 62;",
    "",
    "    array<long long, LOG + 1> basis;",
    "    long long sz;",
    "",
    "    LinearBasis()",
    "    {",
    "        basis.fill(0);",
    "        sz = 0;",
    "    }",
    "",
    "    // Insert x long longo basis. Returns true if independent.",
    "    // O(LOG)",
    "    bool insert(long long x)",
    "    {",
    "        for (long long i = LOG; i >= 0; i--)",
    "        {",
    "            if (!(x & (1LL << i)))",
    "                continue;",
    "",
    "            if (!basis[i])",
    "            {",
    "                basis[i] = x;",
    "                sz++;",
    "                return true;",
    "            }",
    "",
    "            x ^= basis[i];",
    "        }",
    "",
    "        return false;",
    "    }",
    "",
    "    // Check if x can be represented.",
    "    // O(LOG)",
    "    bool canRepresent(long long x) const",
    "    {",
    "        for (long long i = LOG; i >= 0; i--)",
    "        {",
    "            if (!(x & (1LL << i)))",
    "                continue;",
    "",
    "            if (!basis[i])",
    "                return false;",
    "",
    "            x ^= basis[i];",
    "        }",
    "",
    "        return true;",
    "    }",
    "",
    "    // Maximum XOR obtainable from a subset.",
    "    // O(LOG)",
    "    long long maxXor() const",
    "    {",
    "        long long res = 0;",
    "",
    "        for (long long i = LOG; i >= 0; i--)",
    "        {",
    "            if (basis[i])",
    "                res = max(res, res ^ basis[i]);",
    "        }",
    "",
    "        return res;",
    "    }",
    "",
    "    // Maximum (x XOR subset).",
    "    // O(LOG)",
    "    long long maxXor(long long x) const",
    "    {",
    "        long long res = x;",
    "",
    "        for (long long i = LOG; i >= 0; i--)",
    "        {",
    "            if (basis[i])",
    "                res = max(res, res ^ basis[i]);",
    "        }",
    "",
    "        return res;",
    "    }",
    "",
    "    // Minimum (x XOR subset).",
    "    // O(LOG)",
    "    long long minXor(long long x) const",
    "    {",
    "        long long res = x;",
    "",
    "        for (long long i = LOG; i >= 0; i--)",
    "        {",
    "            if (basis[i] && (res ^ basis[i]) < res)",
    "                res ^= basis[i];",
    "        }",
    "",
    "        return res;",
    "    }",
    "",
    "    // Reduce basis for kthXor / minNonZero.",
    "    // O(LOG^2)",
    "    void rebuild()",
    "    {",
    "        for (long long i = LOG; i >= 0; i--)",
    "        {",
    "            if (!basis[i])",
    "                continue;",
    "",
    "            for (long long j = i - 1; j >= 0; j--)",
    "            {",
    "                if (basis[j] && (basis[i] & (1LL << j)))",
    "                    basis[i] ^= basis[j];",
    "            }",
    "        }",
    "    }",
    "",
    "    // Minimum non-zero XOR.",
    "    // O(LOG^2)",
    "    long long minNonZero() const",
    "    {",
    "        LinearBasis temp = *this;",
    "        temp.rebuild();",
    "",
    "        for (long long i = 0; i <= LOG; i++)",
    "        {",
    "            if (temp.basis[i])",
    "                return temp.basis[i];",
    "        }",
    "",
    "        return 0;",
    "    }",
    "",
    "    // k-th smallest XOR, 0-indexed.",
    "    // O(LOG^2)",
    "    long long kthXor(long long k) const",
    "    {",
    "        LinearBasis temp = *this;",
    "        temp.rebuild();",
    "",
    "        if (temp.sz >= 63)",
    "            return -1;",
    "",
    "        if (k < 0 || k >= (1LL << temp.sz))",
    "            return -1;",
    "",
    "        long long res = 0;",
    "        long long idx = 0;",
    "",
    "        for (long long i = 0; i <= LOG; i++)",
    "        {",
    "            if (!temp.basis[i])",
    "                continue;",
    "",
    "            if ((k >> idx) & 1LL)",
    "                res ^= temp.basis[i];",
    "",
    "            idx++;",
    "        }",
    "",
    "        return res;",
    "    }",
    "",
    "    // Merge another basis long longo this one.",
    "    // O(LOG^2)",
    "    void merge(const LinearBasis& other)",
    "    {",
    "        for (long long i = 0; i <= LOG; i++)",
    "        {",
    "            if (other.basis[i])",
    "                insert(other.basis[i]);",
    "        }",
    "    }",
    "",
    "    // Rank / dimension of the basis.",
    "    // O(1)",
    "    long long rank() const",
    "    {",
    "        return sz;",
    "    }",
    "",
    "    // Number of distinct XOR values = 2^sz.",
    "    // Safe for sz <= 62.",
    "    long long count() const",
    "    {",
    "        if (sz >= 63)",
    "            return -1;",
    "",
    "        return 1LL << sz;",
    "    }",
    "};",
    "",
    "signed main()",
    "{",
    "    ios::sync_with_stdio(false);",
    "    cin.tie(nullptr);",
    "",
    "    LinearBasis lb;",
    "    ",
    "    long long n;",
    "    cin >> n;",
    "    vector<long long>v(n);",
    "    for (long long i = 0; i < n;i++)",
    "    {",
    "        cin >> v[i];",
    "        lb.insert(v[i]);",
    "    }",
    "    cout << lb.maxXor() << endl;",
    "    $0",
    "    return 0;",
    "}"
  ],
  "description": ""
},
"arithmetic": {
  "prefix": "arithmetic",
  "body": [
    "#include<bits/stdc++.h>",
    "using namespace std;",
    "const long long MOD = 1e9 + 7;",
    "",
    "long long add(long long a, long long b, long long m = MOD)",
    "{",
    "    return (((a % m) + (b % m)) % m + m) % m;",
    "}",
    "",
    "long long sub(long long a, long long b, long long m = MOD)",
    "{",
    "    return (((a % m) - (b % m)) % m + m) % m;",
    "}",
    "",
    "long long mul(long long a, long long b, long long m = MOD)",
    "{",
    "    return ((a % m) * (b % m)) % m;",
    "}",
    "",
    "long long power_(long long a, long long power, long long m = MOD)",
    "{",
    "    long long res = 1;",
    "    a %= m;",
    "    while (power > 0)",
    "    {",
    "        if (power & 1)",
    "        {",
    "            res = (res * a) % m;",
    "        }",
    "        a = (a * a) % m;",
    "        power >>= 1;",
    "    }",
    "    return res;",
    "}",
    "",
    "long long modInverse(long long a, long long m = MOD)",
    "{",
    "    return power_(a, m - 2, m);",
    "}",
    "",
    "long long div_(long long a, long long b, long long m = MOD)",
    "{",
    "    return mul(a, modInverse(b, m), m);",
    "}",
    "",
    "class Comb {",
    "    vector<long long> f, invf;",
    "public:",
    "    Comb(long long n) : f(n + 1), invf(n + 1) {",
    "        f[0] = 1;",
    "        for (long long i = 1; i <= n; i++) f[i] = mul(f[i - 1], i);",
    "        invf[n] = modInverse(f[n]);",
    "        for (long long i = n - 1; i >= 0; i--) invf[i] = mul(invf[i + 1], i + 1);",
    "    }",
    "    long long nCr(long long n, long long r) const {",
    "        return r < 0 || r > n ? 0 : mul(f[n], mul(invf[r], invf[n - r]));",
    "    }",
    "    long long nPr(long long n, long long r) const {",
    "        return r < 0 || r > n ? 0 : mul(f[n], invf[n - r]);",
    "    }",
    "    long long fact(long long n) const {",
    "        return f[n];",
    "    }",
    "    long long invFact(long long n) const {",
    "        return invf[n];",
    "    }",
    "};",
    "",
    "signed main()",
    "{",
    "    ios::sync_with_stdio(false);",
    "    cin.tie(nullptr);",
    "",
    "    Comb comb(200005);",
    "",
    "    $0",
    "    return 0;",
    "}"
  ],
  "description": ""
},
