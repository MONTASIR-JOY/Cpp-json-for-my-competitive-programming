"segment_tree_subarray_sum": {
  "prefix": "segment_tree_subarray_sum",
  "body": [
    "#include<bits/stdc++.h>",
    "using namespace std;",
    "",
    "// Node structure to track subarray states",
    "struct Node {",
    "    long long sum;",
    "    long long pref;",
    "    long long suff;",
    "    long long ans;",
    "};",
    "",
    "const long long maxN = 2e5 + 9; // Expanded to 2e5 as per standard competitive programming constraints",
    "long long a[maxN];",
    "Node t[4 * maxN];",
    "",
    "// Merge logic to combine two subproblems",
    "Node mergeNodes(const Node& left, const Node& right) {",
    "    Node parent;",
    "    parent.sum = left.sum + right.sum;",
    "    parent.pref = max(left.pref, left.sum + right.pref);",
    "    parent.suff = max(right.suff, right.sum + left.suff);",
    "    parent.ans = max({left.ans, right.ans, left.suff + right.pref});",
    "    return parent;",
    "}",
    "",
    "void build(long long node, long long start, long long end)",
    "{",
    "    if(start == end)",
    "    {",
    "        long long val = a[start];",
    "        // max(0LL, val) handles empty subarrays. Change to 'val' if empty arrays are forbidden.",
    "        t[node] = {val, max(0LL, val), max(0LL, val), max(0LL, val)};",
    "        return;",
    "    }",
    "    long long mid = (start + end) / 2;         ",
    "    long long left = 2 * node;                 ",
    "    long long right = 2 * node + 1;            ",
    "    build(left, start, mid);",
    "    build(right, mid + 1, end);",
    "    t[node] = mergeNodes(t[left], t[right]); // Updated",
    "}",
    "",
    "void update(long long node, long long start, long long end, long long idx, long long val)",
    "{",
    "    if(idx < start || idx > end)",
    "    {",
    "        return;",
    "    }",
    "    if(start == end)",
    "    {",
    "        a[idx] = val; // Sync original array array if needed",
    "        t[node] = {val, max(0LL, val), max(0LL, val), max(0LL, val)};",
    "        return;",
    "    }",
    "    long long mid = (start + end) / 2;",
    "    long long left = 2 * node;",
    "    long long right = 2 * node + 1;",
    "    update(left, start, mid, idx, val);",
    "    update(right, mid + 1, end, idx, val);",
    "    t[node] = mergeNodes(t[left], t[right]); // Updated",
    "}",
    "",
    "Node query(long long node, long long start, long long end, long long l, long long r)",
    "{",
    "    // Out of bounds base case: Return neutral elements (0)",
    "    if(end < l || r < start)",
    "    {",
    "        return {0, 0, 0, 0}; ",
    "    }",
    "    if(start >= l && end <= r)",
    "    {",
    "        return t[node];",
    "    }",
    "    long long mid = (start + end) / 2;",
    "    long long left = 2 * node;",
    "    long long right = 2 * node + 1;",
    "    ",
    "    // Updated: Merges structural nodes across segment borders",
    "    return mergeNodes(query(left, start, mid, l, r), query(right, mid + 1, end, l, r)); ",
    "}",
    "",
    "signed main()",
    "{",
    "    ios::sync_with_stdio(false);",
    "    cin.tie(nullptr);",
    "",
    "    long long n, m;",
    "    if (!(cin >> n >> m)) return 0;",
    "    ",
    "    for (long long i = 1; i <= n; i++)",
    "    {",
    "        cin >> a[i];",
    "    }",
    "    build(1, 1, n);",
    "",
    "    while(m--) ",
    "    {",
    "        long long idx, val;",
    "        cin >> idx >> val;",
    "        update(1, 1, n, idx, val);",
    "        cout << t[1].ans << endl;",
    "    }",
    "    ",
    "    return 0;",
    "}",
    ""
  ],
  "description": ""
},
"segment_tree_merge_sort": {
  "prefix": "segment_tree_merge_sort",
  "body": [
    "#include <bits/stdc++.h>",
    "using namespace std;",
    "",
    "const long long maxN = 2e5 + 9;",
    "long long a[maxN];",
    "vector<long long> t[4 * maxN];",
    "void build(long long node, long long start, long long end)",
    "{",
    "    if (start == end)",
    "    {",
    "        t[node] = {a[start]};",
    "        return;",
    "    }",
    "    long long mid = (start + end) / 2;",
    "    long long left = 2 * node;",
    "    long long right = 2 * node + 1;",
    "    build(left, start, mid);",
    "    build(right, mid + 1, end);",
    "",
    "    t[node].resize(t[left].size() + t[right].size());",
    "    merge(t[left].begin(), t[left].end(),",
    "          t[right].begin(), t[right].end(),",
    "          t[node].begin());",
    "}",
    "",
    "long long query(long long node, long long start, long long end, long long l, long long r, long long k)",
    "{",
    "    if (end < l || r < start)",
    "    {",
    "        return 0;",
    "    }",
    "    if (start >= l && end <= r)",
    "    {",
    "        auto it = upper_bound(t[node].begin(), t[node].end(), k);",
    "        return t[node].end() - it;",
    "    }",
    "    long long mid = (start + end) / 2;",
    "    long long left = 2 * node;",
    "    long long right = 2 * node + 1;",
    "",
    "    return query(left, start, mid, l, r, k) + query(right, mid + 1, end, l, r, k);",
    "}",
    "",
    "signed main()",
    "{",
    "    ios::sync_with_stdio(false);",
    "    cin.tie(nullptr);",
    "",
    "    long long n, m;",
    "    if (!(cin >> n >> m))",
    "        return 0;",
    "",
    "    for (long long i = 1; i <= n; i++)",
    "    {",
    "        cin >> a[i];",
    "    }",
    "    build(1, 1, n);",
    "",
    "    while (m--)",
    "    {",
    "        long long i, j, k;",
    "        cin >> i >> j >> k;",
    "        // Output the count of elements > k in range [i, j]",
    "        cout << query(1, 1, n, i, j, k) << endl;",
    "    }",
    "",
    "    return 0;",
    "}"
  ],
  "description": ""
},
"WaveletTree": {
  "prefix": "WaveletTree",
  "body": [
    "#include <bits/stdc++.h>",
    "using namespace std;",
    "",
    "struct Elem",
    "{",
    "    long long c, v;",
    "};",
    "",
    "struct WaveletTree",
    "{",
    "    long long lo, hi;",
    "    unique_ptr<WaveletTree> L, R;",
    "    vector<long long> prefLeft;",
    "    vector<long long> prefSum;",
    "    const vector<long long> *vals = nullptr;",
    "",
    "    WaveletTree(const vector<Elem> &arr, long long x, long long y)",
    "        : lo(x), hi(y)",
    "    {",
    "        long long n = (long long)arr.size();",
    "        prefLeft.reserve(n + 1);",
    "        prefSum.reserve(n + 1);",
    "        prefLeft.push_back(0);",
    "        prefSum.push_back(0);",
    "",
    "        if (!n)",
    "            return;",
    "",
    "        if (lo == hi)",
    "        {",
    "            for (auto &e : arr)",
    "            {",
    "                prefLeft.push_back(prefLeft.back() + 1);",
    "                prefSum.push_back(prefSum.back() + e.v);",
    "            }",
    "            return;",
    "        }",
    "",
    "        long long mid = (lo + hi) >> 1;",
    "        vector<Elem> la, ra;",
    "        la.reserve(n);",
    "        ra.reserve(n);",
    "",
    "        for (auto &e : arr)",
    "        {",
    "            if (e.c <= mid)",
    "            {",
    "                la.push_back(e);",
    "                prefLeft.push_back(prefLeft.back() + 1);",
    "            }",
    "            else",
    "            {",
    "                ra.push_back(e);",
    "                prefLeft.push_back(prefLeft.back());",
    "            }",
    "            prefSum.push_back(prefSum.back() + e.v);",
    "        }",
    "",
    "        if (!la.empty())",
    "            L = make_unique<WaveletTree>(la, lo, mid);",
    "        if (!ra.empty())",
    "            R = make_unique<WaveletTree>(ra, mid + 1, hi);",
    "    }",
    "",
    "    // k-th smallest rank in [l,r]",
    "    long long kth(long long l, long long r, long long k) const",
    "    {",
    "        if (l > r || k <= 0 || k > r - l + 1)",
    "            return -1;",
    "        if (lo == hi)",
    "            return lo;",
    "",
    "        long long inLeft = prefLeft[r] - prefLeft[l - 1];",
    "        if (k <= inLeft)",
    "        {",
    "            return L->kth(prefLeft[l - 1] + 1, prefLeft[r], k);",
    "        }",
    "        else",
    "        {",
    "            return R->kth(l - prefLeft[l - 1], r - prefLeft[r], k - inLeft);",
    "        }",
    "    }",
    "",
    "    // count of elements with rank <= k in [l,r]",
    "    long long countLTE(long long l, long long r, long long k) const",
    "    {",
    "        if (l > r || k < lo)",
    "            return 0;",
    "        if (hi <= k)",
    "            return r - l + 1;",
    "",
    "        long long lb = prefLeft[l - 1], rb = prefLeft[r];",
    "        long long res = 0;",
    "        if (L)",
    "            res += L->countLTE(lb + 1, rb, k);",
    "        if (R)",
    "            res += R->countLTE(l - lb, r - rb, k);",
    "        return res;",
    "    }",
    "",
    "    // count of elements with rank == value in [l,r]",
    "    long long countEqual(long long l, long long r, long long value) const",
    "    {",
    "        if (l > r || value < lo || value > hi)",
    "            return 0;",
    "        if (lo == hi)",
    "            return r - l + 1;",
    "",
    "        long long mid = (lo + hi) >> 1;",
    "        long long lb = prefLeft[l - 1], rb = prefLeft[r];",
    "        if (value <= mid)",
    "        {",
    "            return L ? L->countEqual(lb + 1, rb, value) : 0;",
    "        }",
    "        else",
    "        {",
    "            return R ? R->countEqual(l - lb, r - rb, value) : 0;",
    "        }",
    "    }",
    "",
    "    // sum of original values whose rank < k in [l,r]",
    "    long long sumLess(long long l, long long r, long long k) const",
    "    {",
    "        if (l > r || k <= lo)",
    "            return 0;",
    "        if (hi < k)",
    "            return prefSum[r] - prefSum[l - 1];",
    "",
    "        long long lb = prefLeft[l - 1], rb = prefLeft[r];",
    "        long long res = 0;",
    "        if (L)",
    "            res += L->sumLess(lb + 1, rb, k);",
    "        if (R)",
    "            res += R->sumLess(l - lb, r - rb, k);",
    "        return res;",
    "    }",
    "",
    "    // count of elements with rank in [p,q] within [l,r]",
    "    long long rangeCount(long long l, long long r, long long p, long long q) const",
    "    {",
    "        if (l > r || q < lo || p > hi || p > q)",
    "            return 0;",
    "        if (p <= lo && hi <= q)",
    "            return r - l + 1;",
    "",
    "        long long lb = prefLeft[l - 1], rb = prefLeft[r];",
    "        long long res = 0;",
    "        if (L)",
    "            res += L->rangeCount(lb + 1, rb, p, q);",
    "        if (R)",
    "            res += R->rangeCount(l - lb, r - rb, p, q);",
    "        return res;",
    "    }",
    "",
    "    // minimum rank in [l,r] (unrestricted)",
    "    long long mn(long long l, long long r) const",
    "    {",
    "        if (l > r)",
    "            return LLONG_MAX;",
    "        if (lo == hi)",
    "            return lo;",
    "",
    "        long long lb = prefLeft[l - 1], rb = prefLeft[r];",
    "        long long lc = rb - lb;",
    "        long long rc = (r - l + 1) - lc;",
    "        if (L && lc > 0)",
    "            return L->mn(lb + 1, rb);",
    "        if (R && rc > 0)",
    "            return R->mn(l - lb, r - rb);",
    "        return lo;",
    "    }",
    "",
    "    // maximum rank in [l,r] (unrestricted)",
    "    long long mx(long long l, long long r) const",
    "    {",
    "        if (l > r)",
    "            return LLONG_MIN;",
    "        if (lo == hi)",
    "            return lo;",
    "",
    "        long long lb = prefLeft[l - 1], rb = prefLeft[r];",
    "        long long lc = rb - lb;",
    "        long long rc = (r - l + 1) - lc;",
    "        if (R && rc > 0)",
    "            return R->mx(l - lb, r - rb);",
    "        if (L && lc > 0)",
    "            return L->mx(lb + 1, rb);",
    "        return lo;",
    "    }",
    "",
    "    // minimum rank in [l,r] restricted to ranks in [p,q]; -1 if none",
    "    long long mnRankInRange(long long l, long long r, long long p, long long q) const",
    "    {",
    "        if (l > r || p > q || q < lo || p > hi)",
    "            return -1;",
    "        if (lo == hi)",
    "            return lo;",
    "        if (p <= lo && hi <= q)",
    "            return mn(l, r);",
    "",
    "        long long lb = prefLeft[l - 1], rb = prefLeft[r];",
    "        long long lc = rb - lb;",
    "        long long rc = (r - l + 1) - lc;",
    "",
    "        if (L && lc > 0)",
    "        {",
    "            long long res = L->mnRankInRange(lb + 1, rb, p, q);",
    "            if (res >= 0)",
    "                return res;",
    "        }",
    "        if (R && rc > 0)",
    "        {",
    "            long long res = R->mnRankInRange(l - lb, r - rb, p, q);",
    "            if (res >= 0)",
    "                return res;",
    "        }",
    "        return -1;",
    "    }",
    "",
    "    // maximum rank in [l,r] restricted to ranks in [p,q]; -1 if none",
    "    long long mxRankInRange(long long l, long long r, long long p, long long q) const",
    "    {",
    "        if (l > r || p > q || q < lo || p > hi)",
    "            return -1;",
    "        if (lo == hi)",
    "            return lo;",
    "        if (p <= lo && hi <= q)",
    "            return mx(l, r);",
    "",
    "        long long lb = prefLeft[l - 1], rb = prefLeft[r];",
    "        long long lc = rb - lb;",
    "        long long rc = (r - l + 1) - lc;",
    "",
    "        if (R && rc > 0)",
    "        {",
    "            long long res = R->mxRankInRange(l - lb, r - rb, p, q);",
    "            if (res >= 0)",
    "                return res;",
    "        }",
    "        if (L && lc > 0)",
    "        {",
    "            long long res = L->mxRankInRange(lb + 1, rb, p, q);",
    "            if (res >= 0)",
    "                return res;",
    "        }",
    "        return -1;",
    "    }",
    "",
    "    // ── raw-value wrappers ──",
    "",
    "    long long kthValue(long long l, long long r, long long k) const",
    "    {",
    "        long long c = kth(l, r, k);",
    "        return c < 0 ? -1 : (*vals)[c];",
    "    }",
    "",
    "    long long countAtMost(long long l, long long r, long long x) const",
    "    {",
    "        const auto &s = *vals;",
    "        long long ck = (long long)(upper_bound(s.begin(), s.end(), x) - s.begin()) - 1;",
    "        return ck < 0 ? 0 : countLTE(l, r, ck);",
    "    }",
    "",
    "    long long countOf(long long l, long long r, long long x) const",
    "    {",
    "        const auto &s = *vals;",
    "        long long ck = (long long)(lower_bound(s.begin(), s.end(), x) - s.begin());",
    "        if (ck >= (long long)s.size() || s[ck] != x)",
    "            return 0;",
    "        return countEqual(l, r, ck);",
    "    }",
    "",
    "    long long sumBelow(long long l, long long r, long long x) const",
    "    {",
    "        const auto &s = *vals;",
    "        long long ck = (long long)(lower_bound(s.begin(), s.end(), x) - s.begin());",
    "        return ck <= 0 ? 0 : sumLess(l, r, ck);",
    "    }",
    "",
    "    long long countInRange(long long l, long long r, long long p, long long q) const",
    "    {",
    "        if (p > q)",
    "            return 0;",
    "        const auto &s = *vals;",
    "        long long cp = (long long)(lower_bound(s.begin(), s.end(), p) - s.begin());",
    "        long long cq = (long long)(upper_bound(s.begin(), s.end(), q) - s.begin()) - 1;",
    "        return cp > cq ? 0 : rangeCount(l, r, cp, cq);",
    "    }",
    "",
    "    long long minValue(long long l, long long r) const",
    "    {",
    "        if (l > r)",
    "            return LLONG_MAX;",
    "        return (*vals)[mn(l, r)];",
    "    }",
    "",
    "    long long maxValue(long long l, long long r) const",
    "    {",
    "        if (l > r)",
    "            return LLONG_MIN;",
    "        return (*vals)[mx(l, r)];",
    "    }",
    "",
    "    // 4-arg overloads: min/max VALUE in [l,r] restricted to values in [p,q]",
    "    long long mn(long long l, long long r, long long p, long long q) const",
    "    {",
    "        if (l > r || p > q)",
    "            return LLONG_MAX;",
    "        const auto &s = *vals;",
    "        long long cp = (long long)(lower_bound(s.begin(), s.end(), p) - s.begin());",
    "        long long cq = (long long)(upper_bound(s.begin(), s.end(), q) - s.begin()) - 1;",
    "        if (cp > cq)",
    "            return LLONG_MAX;",
    "        long long c = mnRankInRange(l, r, cp, cq);",
    "        return c < 0 ? LLONG_MAX : (*vals)[c];",
    "    }",
    "",
    "    long long mx(long long l, long long r, long long p, long long q) const",
    "    {",
    "        if (l > r || p > q)",
    "            return LLONG_MIN;",
    "        const auto &s = *vals;",
    "        long long cp = (long long)(lower_bound(s.begin(), s.end(), p) - s.begin());",
    "        long long cq = (long long)(upper_bound(s.begin(), s.end(), q) - s.begin()) - 1;",
    "        if (cp > cq)",
    "            return LLONG_MIN;",
    "        long long c = mxRankInRange(l, r, cp, cq);",
    "        return c < 0 ? LLONG_MIN : (*vals)[c];",
    "    }",
    "};",
    "",
    "// builds tree from raw array, handles compression internally",
    "struct WaveletBuilder",
    "{",
    "    vector<long long> sorted;",
    "    unique_ptr<WaveletTree> tree;",
    "",
    "    explicit WaveletBuilder(const vector<long long> &raw)",
    "    {",
    "        sorted = raw;",
    "        sort(sorted.begin(), sorted.end());",
    "        sorted.erase(unique(sorted.begin(), sorted.end()), sorted.end());",
    "",
    "        vector<Elem> comp(raw.size());",
    "        for (size_t i = 0; i < raw.size(); i++)",
    "        {",
    "            long long c = lower_bound(sorted.begin(), sorted.end(), raw[i]) - sorted.begin();",
    "            comp[i] = {c, raw[i]};",
    "        }",
    "",
    "        tree = make_unique<WaveletTree>(comp, 0, (long long)sorted.size() - 1);",
    "        tree->vals = &sorted;",
    "    }",
    "};",
    "",
    "",
    "//  Usage (all indices are 1-based):",
    "//",
    "//      wt.kthValue(l, r, k)         -> k-th smallest value in [l, r]          O(log σ)",
    "//      wt.countAtMost(l, r, x)      -> count of values <= x in [l, r]         O(log σ + log n)",
    "//      wt.countOf(l, r, x)          -> count of values == x in [l, r]         O(log σ + log n)",
    "//      wt.sumBelow(l, r, x)         -> sum of values < x in [l, r]            O(log σ + log n)",
    "//      wt.countInRange(l, r, p, q)  -> count of values in [p, q] in [l, r]    O(log σ + log n)",
    "//      wt.minValue(l, r)            -> minimum value in [l, r]                O(log σ)",
    "//      wt.maxValue(l, r)            -> maximum value in [l, r]                O(log σ)",
    "//      wt.mn(l, r, p, q)            -> min value in [l, r] restricted [p, q]  O(log σ + log n)",
    "//      wt.mx(l, r, p, q)            -> max value in [l, r] restricted [p, q]  O(log σ + log n)",
    "//",
    "//  Where:",
    "//      n = array length",
    "//      σ = number of distinct values (σ ≤ n)",
    "//      log σ = wavelet tree height",
    "//      The extra log n comes from binary searching the sorted-values table",
    "//      to convert a raw value (x, p, q) into a compressed rank before descending.",
    "",
    "signed main()",
    "{",
    "    ios::sync_with_stdio(false);",
    "    cin.tie(nullptr);",
    "",
    "    long long n;",
    "    cin >> n;",
    "",
    "    vector<long long> v(n+1);",
    "    for (long long i = 1; i <= n;i++)",
    "    {",
    "        cin >> v[i];",
    "    }",
    "",
    "    WaveletBuilder wb(vector<long long>(v.begin()+1,v.end()));",
    "    auto &wt = *wb.tree;",
    "    ",
    "    $0",
    "    return 0;",
    "}"
  ],
  "description": ""
},
"FenwickTree": {
  "prefix": "FenwickTree",
  "body": [
    "struct FenwickTree",
    "{",
    "    vector<long long> tree;",
    "    long long n;",
    "",
    "    FenwickTree(long long n) { this->n = n, tree.resize(n + 1, 0); }",
    "",
    "    void add(long long idx, long long val)",
    "    {",
    "        while (idx <= n)",
    "        {",
    "            tree[idx] += val, idx += idx & (-idx);",
    "        }",
    "    }",
    "",
    "    long long query(long long idx)",
    "    {",
    "        long long sum = 0;",
    "        while (idx > 0)",
    "            sum += tree[idx], idx -= idx & (-idx);",
    "        return sum;",
    "    }",
    "",
    "    long long rangeQuery(long long l, long long r) { return query(r) - query(l - 1); }",
    "",
    "    void rangeAdd(long long l, long long r, long long val)",
    "    {",
    "        add(l, val);",
    "        if (r + 1 <= n)",
    "            add(r + 1, -val);",
    "    }",
    "",
    "    long long pointQuery(long long idx)",
    "    {",
    "        return query(idx);",
    "    }",
    "",
    "    long long inversion_count(vector<long long> arr)",
    "    {",
    "        vector<long long> s = arr;",
    "        sort(s.begin(), s.end());",
    "        s.erase(unique(s.begin(), s.end()), s.end());",
    "",
    "        FenwickTree ft(s.size());",
    "        long long icount = 0;",
    "        for (long long i = (long long)arr.size() - 1; i >= 0; i--)",
    "        {",
    "            long long x = lower_bound(s.begin(), s.end(), arr[i]) - s.begin() + 1;",
    "            icount += ft.query(x - 1), ft.add(x, 1);",
    "        }",
    "        return icount;",
    "    }",
    "};"
  ],
  "description": ""
},
"dynamicsegtree": {
  "prefix": "dynamicsegtree",
  "body": [
    "#include <bits/stdc++.h>",
    "using namespace std;",
    "",
    "enum Op",
    "{",
    "    OP_MIN,",
    "    OP_MAX,",
    "    OP_SUM,",
    "    OP_GCD,",
    "    OP_XOR",
    "};",
    "",
    "Op OP = OP_MIN;",
    "",
    "const long long N = 1e5 + 5;",
    "const long long NONE = LLONG_MIN;",
    "const long long INF = (long long)1e18;",
    "",
    "long long identity()",
    "{",
    "    switch (OP)",
    "    {",
    "    case OP_MIN:",
    "        return LLONG_MAX;",
    "    case OP_MAX:",
    "        return LLONG_MIN;",
    "    case OP_SUM:",
    "        return 0;",
    "    case OP_GCD:",
    "        return 0;",
    "    case OP_XOR:",
    "        return 0;",
    "    }",
    "    return 0;",
    "}",
    "",
    "long long combine(long long a, long long b)",
    "{",
    "    switch (OP)",
    "    {",
    "    case OP_MIN:",
    "        return min(a, b);",
    "    case OP_MAX:",
    "        return max(a, b);",
    "    case OP_SUM:",
    "        return a + b;",
    "    case OP_GCD:",
    "        return __gcd(a, b);",
    "    case OP_XOR:",
    "        return a ^ b;",
    "    }",
    "    return 0;",
    "}",
    "",
    "bool addSupported()",
    "{",
    "    return OP == OP_MIN || OP == OP_MAX || OP == OP_SUM;",
    "}",
    "",
    "long long assignValue(long long v, long long len)",
    "{",
    "    switch (OP)",
    "    {",
    "    case OP_MIN:",
    "        return v;",
    "    case OP_MAX:",
    "        return v;",
    "    case OP_SUM:",
    "        return v * len;",
    "    case OP_GCD:",
    "        return v;",
    "    case OP_XOR:",
    "        return (len & 1) ? v : 0;",
    "    }",
    "    return v;",
    "}",
    "",
    "long long addValue(long long cur, long long v, long long len)",
    "{",
    "    switch (OP)",
    "    {",
    "    case OP_MIN:",
    "        return cur + v;",
    "    case OP_MAX:",
    "        return cur + v;",
    "    case OP_SUM:",
    "        return cur + v * len;",
    "    default:",
    "        return cur;",
    "    }",
    "}",
    "",
    "long long MODE = 0;",
    "long long DEFAULT_VALUE = 1;",
    "long long n, k, M;",
    "vector<long long> b;",
    "",
    "const long long maxn = N + 5;",
    "const long long max_logn = 20;",
    "",
    "struct SparseTable",
    "{",
    "    long long lg[maxn];",
    "    long long dp[max_logn][maxn];",
    "",
    "    SparseTable()",
    "    {",
    "        lg[1] = 0;",
    "        for (long long i = 2; i < maxn; i++)",
    "        {",
    "            lg[i] = lg[i / 2] + 1;",
    "        }",
    "    }",
    "",
    "    void build(const vector<long long> &arr)",
    "    {",
    "        long long sz = (long long)arr.size();",
    "",
    "        for (long long i = 0; i < maxn; i++)",
    "        {",
    "            dp[0][i] = identity();",
    "        }",
    "",
    "        for (long long i = 0; i < sz; i++)",
    "        {",
    "            dp[0][i] = arr[i];",
    "        }",
    "",
    "        for (long long j = 1; j < max_logn; j++)",
    "        {",
    "            for (long long i = 0; i + (1 << j) <= maxn; i++)",
    "            {",
    "                dp[j][i] = combine(dp[j - 1][i], dp[j - 1][i + (1 << (j - 1))]);",
    "            }",
    "        }",
    "    }",
    "",
    "    long long query(long long l, long long r)",
    "    {",
    "        if (l > r)",
    "        {",
    "            return identity();",
    "        }",
    "        long long j = lg[r - l + 1];",
    "        return combine(dp[j][l], dp[j][r - (1 << j) + 1]);",
    "    }",
    "};",
    "",
    "SparseTable spt;",
    "",
    "long long prefixArr[maxn];",
    "",
    "void buildPrefix()",
    "{",
    "    prefixArr[0] = identity();",
    "    for (long long i = 0; i < n; i++)",
    "    {",
    "        prefixArr[i + 1] = combine(prefixArr[i], b[i]);",
    "    }",
    "}",
    "long long rangeInB(long long l, long long r)",
    "{",
    "    if (l > r)",
    "    {",
    "        return identity();",
    "    }",
    "",
    "    if (OP == OP_SUM)",
    "    {",
    "        return prefixArr[r + 1] - prefixArr[l];",
    "    }",
    "    else if (OP == OP_XOR)",
    "    {",
    "        return prefixArr[r + 1] ^ prefixArr[l];",
    "    }",
    "    return spt.query(l, r);",
    "}",
    "",
    "long long repeatedPeriodAgg(long long fullPeriods)",
    "{",
    "    if (fullPeriods == 0)",
    "    {",
    "        return identity();",
    "    }",
    "",
    "    long long periodAgg = rangeInB(0, n - 1);",
    "",
    "    switch (OP)",
    "    {",
    "    case OP_MIN:",
    "    case OP_MAX:",
    "    case OP_GCD:",
    "",
    "        return periodAgg;",
    "    case OP_SUM:",
    "        return periodAgg * fullPeriods;",
    "    case OP_XOR:",
    "        return (fullPeriods & 1) ? periodAgg : 0;",
    "    }",
    "    return periodAgg;",
    "}",
    "",
    "long long getCyclic(long long l, long long r)",
    "{",
    "    long long length = r - l + 1;",
    "    long long fullPeriods = length / n;",
    "    long long remainder = length % n;",
    "    long long startMod = l % n;",
    "",
    "    long long partial = identity();",
    "    if (remainder > 0)",
    "    {",
    "        long long endMod = startMod + remainder - 1;",
    "        if (endMod < n)",
    "        {",
    "            partial = rangeInB(startMod, endMod);",
    "        }",
    "        else",
    "        {",
    "            partial = combine(rangeInB(startMod, n - 1), rangeInB(0, endMod - n));",
    "        }",
    "    }",
    "",
    "    long long repeated = repeatedPeriodAgg(fullPeriods);",
    "    return combine(repeated, partial);",
    "}",
    "",
    "long long getInside(long long l, long long r)",
    "{",
    "    if (l > r)",
    "    {",
    "        return identity();",
    "    }",
    "    return rangeInB((long long)l, (long long)r);",
    "}",
    "",
    "long long initialValue(long long tl, long long tr)",
    "{",
    "    if (MODE == 0)",
    "    {",
    "        return getCyclic(tl, tr);",
    "    }",
    "    else",
    "    {",
    "        if (tr < n)",
    "        {",
    "            return getInside(tl, tr);",
    "        }",
    "        if (tl >= n)",
    "        {",
    "            return DEFAULT_VALUE;",
    "        }",
    "        return combine(getInside(tl, (long long)n - 1), DEFAULT_VALUE);",
    "    }",
    "}",
    "struct node",
    "{",
    "    node *left;",
    "    node *right;",
    "    long long val;",
    "    long long setLazy;",
    "    long long addLazy;",
    "",
    "    node()",
    "    {",
    "        left = nullptr;",
    "        right = nullptr;",
    "        val = identity();",
    "        setLazy = NONE;",
    "        addLazy = 0;",
    "    }",
    "};",
    "",
    "node ns[80 * N];",
    "long long cnt = 0;",
    "",
    "node *create(long long tl, long long tr)",
    "{",
    "    node *tmp;",
    "    if (cnt < 80 * N)",
    "    {",
    "        tmp = &ns[cnt++];",
    "    }",
    "    else",
    "    {",
    "        tmp = new node();",
    "    }",
    "",
    "    tmp->val = initialValue(tl, tr);",
    "    tmp->left = nullptr;",
    "    tmp->right = nullptr;",
    "    tmp->setLazy = NONE;",
    "    tmp->addLazy = 0;",
    "",
    "    return tmp;",
    "}",
    "",
    "void applySet(node *x, long long v, long long len)",
    "{",
    "    x->val = assignValue(v, len);",
    "    x->setLazy = v;",
    "    x->addLazy = 0;",
    "}",
    "",
    "void applyAdd(node *x, long long v, long long len)",
    "{",
    "    if (!addSupported())",
    "    {",
    "        return;",
    "    }",
    "",
    "    x->val = addValue(x->val, v, len);",
    "    if (x->setLazy != NONE)",
    "    {",
    "        x->setLazy += v;",
    "    }",
    "    else",
    "    {",
    "        x->addLazy += v;",
    "    }",
    "}",
    "",
    "void pushdown(node *x, long long tl, long long tr)",
    "{",
    "    long long tm = tl + (tr - tl) / 2;",
    "",
    "    if (x->setLazy != NONE)",
    "    {",
    "        applySet(x->left, x->setLazy, tm - tl + 1);",
    "        applySet(x->right, x->setLazy, tr - tm);",
    "        x->setLazy = NONE;",
    "        x->addLazy = 0;",
    "    }",
    "    if (x->addLazy != 0)",
    "    {",
    "        applyAdd(x->left, x->addLazy, tm - tl + 1);",
    "        applyAdd(x->right, x->addLazy, tr - tm);",
    "        x->addLazy = 0;",
    "    }",
    "}",
    "",
    "struct dynamicsegtree",
    "{",
    "    node *root;",
    "",
    "    dynamicsegtree()",
    "    {",
    "        root = create(0, M);",
    "    }",
    "",
    "    void ensureChildren(node *x, long long tl, long long tm, long long tr)",
    "    {",
    "        if (!x->left)",
    "        {",
    "            x->left = create(tl, tm);",
    "        }",
    "        if (!x->right)",
    "        {",
    "            x->right = create(tm + 1, tr);",
    "        }",
    "    }",
    "",
    "    void update(node *x, long long tl, long long tr, long long l, long long r, long long val, long long type)",
    "    {",
    "        if (l > tr || r < tl)",
    "        {",
    "            return;",
    "        }",
    "",
    "        if (tl >= l && tr <= r)",
    "        {",
    "            if (type == 0)",
    "            {",
    "                applySet(x, val, tr - tl + 1);",
    "            }",
    "            else",
    "            {",
    "                applyAdd(x, val, tr - tl + 1);",
    "            }",
    "            return;",
    "        }",
    "",
    "        long long tm = tl + (tr - tl) / 2;",
    "",
    "        ensureChildren(x, tl, tm, tr);",
    "",
    "        pushdown(x, tl, tr);",
    "",
    "        update(x->left, tl, tm, l, r, val, type);",
    "        update(x->right, tm + 1, tr, l, r, val, type);",
    "",
    "        x->val = combine(x->left->val, x->right->val);",
    "    }",
    "",
    "    void upd(long long l, long long r, long long val)",
    "    {",
    "        update(root, 0, M, l, r, val, 0);",
    "    }",
    "",
    "    void addUpd(long long l, long long r, long long val)",
    "    {",
    "        assert(addSupported() && \"range ADD is not supported for the current operation (GCD/XOR)\");",
    "        update(root, 0, M, l, r, val, 1);",
    "    }",
    "",
    "    long long query(node *x, long long tl, long long tr,long long l, long long r)",
    "    {",
    "        if (l > tr || r < tl)",
    "        {",
    "            return identity();",
    "        }",
    "",
    "        if (tl >= l && tr <= r)",
    "        {",
    "            return x->val;",
    "        }",
    "",
    "        long long tm = tl + (tr - tl) / 2;",
    "",
    "        ensureChildren(x, tl, tm, tr);",
    "",
    "        pushdown(x, tl, tr);",
    "",
    "        return combine(query(x->left, tl, tm, l, r),query(x->right, tm + 1, tr, l, r));",
    "    }",
    "",
    "    long long query(long long l, long long r)",
    "    {",
    "        return query(root, 0, M, l, r);",
    "    }",
    "};",
    "",
    "signed main()",
    "{",
    "    ios::sync_with_stdio(false);",
    "    cin.tie(nullptr);",
    "",
    "    // ── Set operation ──",
    "    OP = OP_MIN; // OP_MIN, OP_MAX, OP_SUM, OP_GCD, OP_XOR",
    "    // ────────────────────────────",
    "",
    "    // ══════════════════════════════════════════════════════════════════════",
    "    //  Mode selection:",
    "    //      0 = CYCLIC   → virtual array = b repeated k times",
    "    //      1 = DEFAULT  → virtual array = b in [0, n-1], DEFAULT in [n, M]",
    "    // ══════════════════════════════════════════════════════════════════════",
    "",
    "    // ── Set virtual array mode ──",
    "    MODE = 0; // 0 = CYCLIC, 1 = DEFAULT",
    "    DEFAULT_VALUE = 1;",
    "    // ────────────────────────────",
    "",
    "    cin >> n >> k;",
    "",
    "    b.resize(n);",
    "    for (long long i = 0; i < n; i++)",
    "    {",
    "        cin >> b[i];",
    "    }",
    "",
    "    spt.build(b);",
    "    buildPrefix();",
    "",
    "    if (k != 0 && n > LLONG_MAX / k)",
    "    {",
    "        M = LLONG_MAX - 5;",
    "    }",
    "    else",
    "    {",
    "        M = n * k - 1;",
    "    }",
    "",
    "    dynamicsegtree seg;",
    "",
    "    long long q;",
    "    cin >> q;",
    "",
    "    while (q--)",
    "    {",
    "        long long type, l, r;",
    "        cin >> type >> l >> r;",
    "        l--;",
    "        r--;",
    "",
    "        if (type == 1)",
    "        {",
    "            long long x;",
    "            cin >> x;",
    "            seg.upd(l, r, x);",
    "        }",
    "        else if (type == 2)",
    "        {",
    "            long long x;",
    "            cin >> x;",
    "            seg.addUpd(l, r, x);",
    "        }",
    "        else",
    "        {",
    "            cout << seg.query(l, r) << endl;",
    "        }",
    "    }",
    "",
    "    return 0;",
    "}"
  ],
  "description": ""
},
"segment_tree_lazy_for_both_set_and_increase": {
  "prefix": "segment_tree_lazy_for_both_set_and_increase",
  "body": [
    "#include<bits/stdc++.h>",
    "using namespace std;",
    "",
    "const long long maxN = 2e5 + 9;",
    "long long a[maxN], t[4 * maxN], lazy1[4 * maxN], lazy2[4 * maxN];",
    "",
    "void build(long long node, long long start, long long end)",
    "{",
    "    lazy1[node] = 0;     // change this",
    "    lazy2[node] = -1;     // change this",
    "    if(start == end)",
    "    {",
    "        t[node] = a[start];",
    "        return;",
    "    }",
    "    long long mid = (start + end) / 2;         //     node",
    "    long long left = 2 * node;                 /*    / \\     */",
    "    long long right = 2 * node + 1;            //   left right",
    "    build(left, start, mid);",
    "    build(right, mid + 1, end);",
    "    t[node] = t[left] + t[right];    // change this",
    "}",
    "",
    "",
    "",
    "void push1(long long node, long long start, long long end)",
    "{",
    "    if(lazy1[node] == 0)   // change this",
    "    {",
    "        return;",
    "    }",
    "    t[node] += (end - start + 1) * lazy1[node];   // give t[node]+lazy[node] for min and mx  XOR: t[node] ^= (end-start+1) % 2 * lazy1[node]",
    "    if(start != end)",
    "    {",
    "        long long left = 2 * node;",
    "        long long right = 2 * node + 1;",
    "        lazy1[left] += lazy1[node];",
    "        lazy1[right] += lazy1[node];",
    "    }",
    "    lazy1[node] = 0;       // change this",
    "}",
    "void push2(long long node, long long start, long long end)",
    "{",
    "    if(lazy2[node]==-1)",
    "    {",
    "        return;",
    "    }",
    "    t[node] = (end - start + 1) * lazy2[node];    // for xor t[node] = (end - start + 1) % 2 * lazy2[node];",
    "    if(start != end)",
    "    {",
    "        long long left = 2 * node;",
    "        long long right = 2 * node + 1;",
    "        lazy2[left] = lazy2[node];",
    "        lazy2[right] = lazy2[node];",
    "        lazy1[left] = 0; ",
    "        lazy1[right] = 0;",
    "    }",
    "    lazy2[node] = -1;",
    "}",
    "",
    "void push(long long node, long long start, long long end)",
    "{",
    "    push2(node, start, end);",
    "    push1(node, start, end);",
    "}",
    "",
    "void update1(long long node, long long start, long long end, long long l, long long r, long long val)",
    "{",
    "    push(node, start, end);",
    "    if(end < l || r < start)",
    "    {",
    "        return;",
    "    }",
    "    if(start >= l && end <= r)",
    "    {",
    "        lazy1[node] += val;     // set correct propagation",
    "        push(node, start, end);",
    "        return;",
    "    }",
    "    long long mid = (start + end) / 2;         //     node",
    "    long long left = 2 * node;                 /*    / \\     */",
    "    long long right = 2 * node + 1;            //   left right",
    "    update1(left, start, mid, l, r, val);",
    "    update1(right, mid + 1, end, l, r, val);",
    "    t[node] = t[left] + t[right];   // change this",
    "}",
    "void update2(long long node, long long start, long long end, long long l, long long r, long long val)",
    "{",
    "    push(node, start, end);",
    "    if(end < l || r < start)",
    "    {",
    "        return;",
    "    }",
    "    if(start >= l && end <= r)",
    "    {",
    "        lazy2[node] = val;     // set correct propagation",
    "        push2(node, start, end);",
    "        return;",
    "    }",
    "    long long mid = (start + end) / 2;         //     node",
    "    long long left = 2 * node;                 /*    / \\     */",
    "    long long right = 2 * node + 1;            //   left right",
    "    update2(left, start, mid, l, r, val);",
    "    update2(right, mid + 1, end, l, r, val);",
    "    t[node] = t[left] + t[right];   // change this",
    "}",
    "",
    "long long query(long long node, long long start, long long end, long long l, long long r)",
    "{",
    "    push(node, start, end);",
    "    if(end < l || r < start)",
    "    {",
    "        return 0;         // return right value",
    "    }",
    "    if(start >= l && end <= r)",
    "    {",
    "        return t[node];",
    "    }",
    "    long long mid = (start + end) / 2;         //     node",
    "    long long left = 2 * node;                 /*    / \\     */",
    "    long long right = 2 * node + 1;            //   left right",
    "    return query(left, start, mid, l, r) + query(right, mid + 1, end, l, r); // change this",
    "}",
    "",
    "signed main()",
    "{",
    "    ios::sync_with_stdio(false);",
    "    cin.tie(nullptr);",
    "",
    "    long long n, m;",
    "    cin >> n >> m;",
    "    for (long long i = 1; i <= n; i++)",
    "    {",
    "        cin >> a[i];",
    "    }",
    "    build(1, 1, n);",
    "",
    "    while(m--)",
    "    {",
    "        long long t;",
    "        cin >> t;",
    "        if(t==1)",
    "        {",
    "            long long l, r, x;",
    "            cin >> l >> r >> x;",
    "            update1(1, 1, n, l, r, x);",
    "        }",
    "        else if(t==2)",
    "        {",
    "            long long l, r, x;",
    "            cin >> l >> r >> x;",
    "            update2(1, 1, n, l, r, x);",
    "        }",
    "        else{",
    "            long long l, r;",
    "            cin >> l >> r;",
    "            cout << query(1, 1, n, l, r) << endl;",
    "        }",
    "    }",
    "    return 0;",
    "}",
    "",
    ""
  ],
  "description": ""
},
"trie": {
  "prefix": "trie",
  "body": [
    "#include <bits/stdc++.h>",
    "using namespace std;",
    "",
    "template <typename T>",
    "struct CSpan {",
    "    const T* data = nullptr;",
    "    size_t n = 0;",
    "",
    "    const T* begin() const noexcept { return data; }",
    "    const T* end()   const noexcept { return data + n; }",
    "};",
    "",
    "template <typename T>",
    "class Trie {",
    "    struct Node {",
    "        unordered_map<T, unique_ptr<Node>> children;",
    "        bool isEnd = false;",
    "    };",
    "",
    "    unique_ptr<Node> root;",
    "    size_t keyCount = 0;",
    "",
    "    template <typename Container>",
    "    const Node* findNode(const Container& key) const {",
    "        const Node* cur = root.get();",
    "        for (const auto& value : key) {",
    "            auto it = cur->children.find(value);",
    "            if (it == cur->children.end())",
    "                return nullptr;",
    "            cur = it->second.get();",
    "        }",
    "        return cur;",
    "    }",
    "",
    "    template <typename It>",
    "    bool eraseImpl(Node* node, It cur, It end) {",
    "        if (cur == end) {",
    "            if (!node->isEnd)",
    "                return false;",
    "            node->isEnd = false;",
    "            return true;",
    "        }",
    "",
    "        auto it = node->children.find(*cur);",
    "        if (it == node->children.end())",
    "            return false;",
    "",
    "        Node* child = it->second.get();",
    "        if (!eraseImpl(child, next(cur), end))",
    "            return false;",
    "",
    "        if (!child->isEnd && child->children.empty())",
    "            node->children.erase(it);",
    "",
    "        return true;",
    "    }",
    "",
    "public:",
    "    Trie() : root(make_unique<Node>()) {}",
    "",
    "    Trie(const Trie&) = delete;",
    "    Trie& operator=(const Trie&) = delete;",
    "",
    "    Trie(Trie&& other) noexcept",
    "        : root(make_unique<Node>()), keyCount(0) {",
    "        root.swap(other.root);",
    "        keyCount = exchange(other.keyCount, 0);",
    "    }",
    "",
    "    Trie& operator=(Trie&& other) noexcept {",
    "        if (this != &other) {",
    "            root.swap(other.root);",
    "            keyCount = exchange(other.keyCount, 0);",
    "        }",
    "        return *this;",
    "    }",
    "",
    "    ~Trie() = default;",
    "",
    "    template <typename Container>",
    "    void insert(const Container& key) {",
    "        Node* cur = root.get();",
    "        for (const auto& value : key) {",
    "            auto& child = cur->children[value];",
    "            if (!child)",
    "                child = make_unique<Node>();",
    "            cur = child.get();",
    "        }",
    "        if (!cur->isEnd) {",
    "            cur->isEnd = true;",
    "            ++keyCount;",
    "        }",
    "    }",
    "",
    "    template <typename Container>",
    "    bool contains(const Container& key) const {",
    "        const Node* node = findNode(key);",
    "        return node != nullptr && node->isEnd;",
    "    }",
    "",
    "    template <typename Container>",
    "    bool hasPrefix(const Container& key) const {",
    "        return findNode(key) != nullptr;",
    "    }",
    "",
    "    template <typename Container>",
    "    size_t longestCommonPrefix(const Container& key) const {",
    "        const Node* cur = root.get();",
    "        size_t length = 0;",
    "        size_t lastEnd = 0;",
    "        for (const auto& value : key) {",
    "            auto it = cur->children.find(value);",
    "            if (it == cur->children.end())",
    "                break;",
    "            cur = it->second.get();",
    "            ++length;",
    "            if (cur->isEnd)",
    "                lastEnd = length;",
    "        }",
    "        return lastEnd;",
    "    }",
    "",
    "    template <typename Container>",
    "    bool erase(const Container& key) {",
    "        if (keyCount == 0)",
    "            return false;",
    "        if (!eraseImpl(root.get(), begin(key), end(key)))",
    "            return false;",
    "        --keyCount;",
    "        return true;",
    "    }",
    "",
    "    template <size_t N>",
    "    void insert(const char (&key)[N]) {",
    "        insert(CSpan<char>{key, N - 1});",
    "    }",
    "",
    "    template <size_t N>",
    "    bool contains(const char (&key)[N]) const {",
    "        return contains(CSpan<char>{key, N - 1});",
    "    }",
    "",
    "    template <size_t N>",
    "    bool hasPrefix(const char (&key)[N]) const {",
    "        return hasPrefix(CSpan<char>{key, N - 1});",
    "    }",
    "",
    "    template <size_t N>",
    "    size_t longestCommonPrefix(const char (&key)[N]) const {",
    "        return longestCommonPrefix(CSpan<char>{key, N - 1});",
    "    }",
    "",
    "    template <size_t N>",
    "    bool erase(const char (&key)[N]) {",
    "        return erase(CSpan<char>{key, N - 1});",
    "    }",
    "",
    "    size_t size() const noexcept { return keyCount; }",
    "    bool empty() const noexcept { return keyCount == 0; }",
    "",
    "    void clear() noexcept {",
    "        root->children.clear();",
    "        root->isEnd = false;",
    "        keyCount = 0;",
    "    }",
    "};",
    "",
    "int main() {",
    "    ios::sync_with_stdio(false);",
    "    cin.tie(nullptr);",
    "",
    "    Trie<char> trie;",
    "",
    "    $0",
    "    return 0;",
    "}"
  ],
  "description": ""
},
"trie_xor": {
  "prefix": "trie_xor",
  "body": [
    "#include <bits/stdc++.h>",
    "using namespace std;",
    "",
    "const long long BITS = 30;",
    "",
    "class Node",
    "{",
    "public:",
    "    long long cnt;",
    "    Node *child[2];",
    "",
    "    Node()",
    "    {",
    "        cnt = 0;",
    "        child[0] = nullptr;",
    "        child[1] = nullptr;",
    "    }",
    "};",
    "",
    "class BinaryXORTrie",
    "{",
    "private:",
    "    Node *root;",
    "",
    "public:",
    "    BinaryXORTrie()",
    "    {",
    "        root = new Node();",
    "        insert(0);",
    "    }",
    "",
    "    void insert(long long val)",
    "    {",
    "        Node *cur = root;",
    "        for (long long i = BITS; i >= 0; i--)",
    "        {",
    "            long long bit = (val >> i) & 1;",
    "            if (cur->child[bit] == nullptr)",
    "            {",
    "                cur->child[bit] = new Node();",
    "            }",
    "            cur = cur->child[bit];",
    "            cur->cnt++;",
    "        }",
    "    }",
    "",
    "    void erase(long long val)",
    "    {",
    "        Node *cur = root;",
    "        for (long long i = BITS; i >= 0; i--)",
    "        {",
    "            long long bit = (val >> i) & 1;",
    "            if (cur->child[bit] == nullptr)",
    "            {",
    "                return;",
    "            }",
    "            cur = cur->child[bit];",
    "            cur->cnt--;",
    "        }",
    "    }",
    "",
    "    long long maxXOR(long long val)",
    "    {",
    "        Node *cur = root;",
    "        long long ans = 0;",
    "        for (long long i = BITS; i >= 0; i--)",
    "        {",
    "            long long bit = (val >> i) & 1;",
    "            long long want = bit ^ 1;",
    "            if (cur->child[want] != nullptr && cur->child[want]->cnt > 0)",
    "            {",
    "                ans |= (1LL << i);",
    "                cur = cur->child[want];",
    "            }",
    "            else if (cur->child[bit] != nullptr && cur->child[bit]->cnt > 0)",
    "            {",
    "                cur = cur->child[bit];",
    "            }",
    "            else",
    "            {",
    "                break;",
    "            }",
    "        }",
    "        return ans;",
    "    }",
    "",
    "    long long minXOR(long long val)",
    "    {",
    "        Node *cur = root;",
    "        long long ans = 0;",
    "        for (long long i = BITS; i >= 0; i--)",
    "        {",
    "            long long bit = (val >> i) & 1;",
    "            long long want = bit;",
    "            if (cur->child[want] != nullptr && cur->child[want]->cnt > 0)",
    "            {",
    "                cur = cur->child[want];",
    "            }",
    "            else if (cur->child[bit ^ 1] != nullptr && cur->child[bit ^ 1]->cnt > 0)",
    "            {",
    "                ans |= (1LL << i);",
    "                cur = cur->child[bit ^ 1];",
    "            }",
    "            else",
    "            {",
    "                break;",
    "            }",
    "        }",
    "        return ans;",
    "    }",
    "",
    "    long long maxXorSubarray(vector<long long> &arr)",
    "    {",
    "        BinaryXORTrie trie;",
    "        long long pref = 0;",
    "        long long best = LLONG_MIN;",
    "        for (long long x : arr)",
    "        {",
    "            pref ^= x;",
    "            best = max(best, trie.maxXOR(pref));",
    "            trie.insert(pref);",
    "        }",
    "        return best;",
    "    }",
    "};",
    "",
    "signed main()",
    "{",
    "    ios::sync_with_stdio(false);",
    "    cin.tie(nullptr);",
    "",
    "    BinaryXORTrie trie;",
    "",
    "    $0",
    "    return 0;",
    "}"
  ],
  "description": ""
},
"mos_algorithm": {
  "prefix": "mos_algorithm",
  "body": [
    "#include <bits/stdc++.h>",
    "using namespace std;",
    "",
    "long long BLOCK_SIZE;",
    "",
    "struct Query",
    "{",
    "    long long l, r, id;",
    "    bool operator<(const Query &other) const",
    "    {",
    "        long long b1 = l / BLOCK_SIZE;",
    "        long long b2 = other.l / BLOCK_SIZE;",
    "        if (b1 != b2)",
    "        {",
    "            return b1 < b2;",
    "        }",
    "        return (b1 & 1) ? (r > other.r) : (r < other.r);",
    "    }",
    "};",
    "",
    "long long arr[300005];",
    "long long freq[300005];",
    "long long distinct_cnt = 0;",
    "",
    "void add(long long idx)",
    "{",
    "    if (freq[arr[idx]]++ == 0)",
    "    {",
    "        distinct_cnt++;",
    "    }",
    "}",
    "",
    "void remove(long long idx)",
    "{",
    "    if (--freq[arr[idx]] == 0)",
    "    {",
    "        distinct_cnt--;",
    "    }",
    "}",
    "",
    "signed main()",
    "{",
    "    ios_base::sync_with_stdio(false);",
    "    cin.tie(NULL);",
    "",
    "    long long N, Q;",
    "    cin >> N >> Q;",
    "",
    "    vector<long long> raw(N);",
    "    for (long long i = 0; i < N; i++)",
    "    {",
    "        cin >> raw[i];",
    "    }",
    "",
    "    vector<long long> vals = raw;",
    "    sort(vals.begin(), vals.end());",
    "    vals.erase(unique(vals.begin(), vals.end()), vals.end());",
    "    for (long long i = 0; i < N; i++)",
    "    {",
    "        arr[i] = lower_bound(vals.begin(), vals.end(), raw[i]) - vals.begin();",
    "    }",
    "",
    "    BLOCK_SIZE = max(1LL, (long long)sqrt(N));",
    "",
    "    vector<Query> queries(Q);",
    "",
    "    for (long long i = 0; i < Q; i++)",
    "    {",
    "        cin >> queries[i].l >> queries[i].r;",
    "        queries[i].l--;",
    "        queries[i].r--;",
    "        queries[i].id = i;",
    "    }",
    "",
    "    sort(queries.begin(), queries.end());",
    "",
    "    vector<long long> ans(Q);",
    "",
    "    long long curL = 0, curR = -1;",
    "",
    "    for (auto &q : queries)",
    "    {",
    "        while (curL > q.l)",
    "        {",
    "            add(--curL);",
    "        }",
    "        while (curR < q.r)",
    "        {",
    "            add(++curR);",
    "        }",
    "        while (curL < q.l)",
    "        {",
    "            remove(curL++);",
    "        }",
    "        while (curR > q.r)",
    "        {",
    "            remove(curR--);",
    "        }",
    "",
    "        ans[q.id] = distinct_cnt;",
    "    }",
    "",
    "    for (long long i = 0; i < Q; i++)",
    "    {",
    "        cout << ans[i] << endl;",
    "    }",
    "",
    "    return 0;",
    "}"
  ],
