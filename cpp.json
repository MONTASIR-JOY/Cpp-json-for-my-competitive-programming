"primeFactorize": {
  "prefix": "primefactorize",
  "body": [
    "vector<long long> primeFactorize(long long n)",
    "{",
    "    vector<long long>factors;",
    "    if(n==1)",
    "    {",
    "        return factors;",
    "    }",
    "    for (long long i = 2; i * i <= n;i++)",
    "    {",
    "        if(n%i==0)",
    "        {",
    "            while(n%i==0)",
    "            {",
    "                n /= i;",
    "                factors.push_back(i);",
    "            }",
    "        }",
    "    }",
    "    if(n!=1)",
    "    {",
    "        factors.push_back(n);",
    "    }",
    "    return factors;",
    "}"
  ],
  "description": ""
},
"ex euclid": {
  "prefix": "ex euclid",
  "body": [
    "tuple<long long,long long,long long> ext_gcd(long long a, long long b) {",
    "    if(b == 0) return {a, 1, 0};",
    "    auto [g, x1, y1] = ext_gcd(b, a % b);",
    "    long long x = y1;",
    "    long long y = x1 - (a / b) * y1;",
    "    return {g, x, y};",
    "}"
  ],
