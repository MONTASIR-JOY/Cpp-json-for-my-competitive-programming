"divisors": {
  "prefix": "divisors",
  "body": [
    "vector<long long> findDivisors(long long n)",
    "{",
    "    vector<long long> divisors;",
    "    if (n <= 0)",
    "    {",
    "        return divisors;",
    "    }",
    "",
    "    for (long long i = 1; i * i <= n; i++)",
    "    {",
    "        if (n % i == 0)",
    "        {",
    "            divisors.push_back(i);",
    "            if (i != n / i)",
    "            {",
    "                divisors.push_back(n / i);",
    "            }",
    "        }",
    "    }",
    "",
    "    sort(divisors.begin(), divisors.end());",
    "    return divisors;",
    "}"
  ],
  "description": ""
