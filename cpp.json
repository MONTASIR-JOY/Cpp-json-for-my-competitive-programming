"sparse table": {
  "prefix": "sparse table",
  "body": [
    "const long long MXN = 1e5 + 9;",
    "const long long LOG = 17;",
    "",
    "long long st[MXN][LOG];",
    "long long log_table[MXN];",
    "",
    "void build_sparse_table(vector<long long>& arr)",
    "{",
    "    long long n = arr.size();",
    "",
    "    log_table[1] = 0;",
    "    for (long long i = 2; i <= n;i++)",
    "    {",
    "        log_table[i] = log_table[i/2] + 1;",
    "    }",
    "",
    "    for (long long i = 0; i < n;i++)",
    "    {",
    "        st[i][0] = arr[i];",
    "    }",
    "",
    "    for (long long j = 1; j < LOG;j++)",
    "    {",
    "        for (long long i = 0; i + (1 << j) <= n;i++)",
    "        {",
    "            st[i][j] = min(st[i][j - 1], st[i + (1 << (j - 1))][j - 1]); // Change here",
    "        }",
    "    }",
    "}",
    "",
    "long long query(long long l,long long r)",
    "{",
    "    long long j = log_table[r - l + 1];",
    "    return min(st[l][j], st[r - (1 << j) + 1][j]); // Change here",
    "}"
  ],
  "description": ""
},
"lis": {
  "prefix": "lis",
  "body": [
    "long long lis(vector<long long> const& a)",
    "{",
    "    long long n = a.size();",
    "    const long long INF = 1e9;",
    "    vector<long long> d(n+1, INF);",
    "    d[0] = -INF;",
    "",
    "    for (long long i = 0; i < n; i++)",
    "    {",
    "        long long l = upper_bound(d.begin(), d.end(), a[i]) - d.begin();",
    "        if (d[l-1] < a[i] && a[i] < d[l])",
    "        {",
    "            d[l] = a[i];",
    "        }",
    "    }",
    "",
    "    long long ans = 0;",
    "    for (long long l = 0; l <= n; l++)",
    "    {",
    "        if (d[l] < INF)",
    "            ans = l;",
    "    }",
    "    return ans;",
    "}",
    "",
    ""
  ],
  "description": ""
