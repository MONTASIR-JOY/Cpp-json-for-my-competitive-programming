"combinatorics": {
  "prefix": "combinatorics",
  "body": [
    "#include<bits/stdc++.h>",
    "using namespace std;",
    "const long long MOD = 1e9 + 7;",
    "",
    "class Comb {",
    "    vector<long long> f, invf;",
    "    long long pow(long long a, long long b) const { ",
    "        long long r = 1; a %= MOD;",
    "        while (b) { if (b & 1) r = (r * a) % MOD; a = (a * a) % MOD; b >>= 1; }",
    "        return r; ",
    "    }",
    "public:",
    "    Comb(long long n) : f(n + 1), invf(n + 1) {",
    "        f[0] = 1;",
    "        for (long long i = 1; i <= n; i++) f[i] = (f[i - 1] * i) % MOD;",
    "        invf[n] = pow(f[n], MOD - 2);",
    "        for (long long i = n - 1; i >= 0; i--) invf[i] = (invf[i + 1] * (i + 1)) % MOD;",
    "    }",
    "    long long nCr(long long n, long long r) const { ",
    "        return r < 0 || r > n ? 0 : (f[n] * invf[r] % MOD * invf[n - r]) % MOD; ",
    "    }",
    "    long long nPr(long long n, long long r) const { ",
    "        return r < 0 || r > n ? 0 : (f[n] * invf[n - r]) % MOD; ",
    "    }",
    "};",
    "int main()",
    "{",
    "    ios::sync_with_stdio(false);",
    "    cin.tie(nullptr);",
    "",
    "    Comb comb(200005);",
    "    ",
    "    $0",
    "    return 0;",
    "}"
  ],
