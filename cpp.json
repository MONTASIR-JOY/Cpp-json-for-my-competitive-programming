"Manacher": {
  "prefix": "Manacher",
  "body": [
    "#include <bits/stdc++.h>",
    "using namespace std;",
    "",
    "struct Manacher",
    "{",
    "    long long n;",
    "    vector<long long> p;",
    "    Manacher(const string &s) : n(s.size())",
    "    {",
    "        string t = \"#\";",
    "        for (char c : s)",
    "        {",
    "            t += c;",
    "            t += '#';",
    "        }",
    "        long long m = t.size();",
    "        p.assign(m, 0);",
    "        for (long long i = 0, l = 0, r = -1; i < m; i++)",
    "        {",
    "            long long k = (i > r) ? 0 : min(p[l + r - i], r - i);",
    "            while (i - k - 1 >= 0 && i + k + 1 < m && t[i - k - 1] == t[i + k + 1])",
    "                k++;",
    "            p[i] = k;",
    "            if (i + k > r)",
    "                l = i - k, r = i + k;",
    "        }",
    "    }",
    "",
    "    // s[l..r] is a palindrome?  O(1)",
    "    bool is_pal(long long l, long long r) const",
    "    {",
    "        return p[l + r + 1] >= r - l + 1;",
    "    }",
    "",
    "    // longest palindromic substring -> {start, length}",
    "    pair<long long, long long> longest() const",
    "    {",
    "        long long best = 0, c = 0;",
    "        for (long long i = 0; i < (long long)p.size(); i++)",
    "            if (p[i] > best)",
    "                best = p[i], c = i;",
    "        return {(c - best) / 2, best};",
    "    }",
    "",
    "    // number of palindromic substrings",
    "    long long count() const",
    "    {",
    "        long long total = 0;",
    "        for (long long x : p)",
    "            total += (x + 1) / 2;",
    "        return total;",
    "    }",
    "",
    "    // odd[i]: longest odd palindrome centered at s[i] (length)",
    "    // even[i]: longest even palindrome centered between s[i-1] and s[i] (length)",
    "    long long odd(long long i) const { return p[2 * i + 1]; }",
    "    long long even(long long i) const { return p[2 * i]; }",
    "};",
    "",
    "signed main()",
    "{",
    "    ios::sync_with_stdio(false);",
    "    cin.tie(nullptr);",
    "          ",
    "    string s;",
    "    cin >> s;",
    "",
    "    Manacher M(s);",
    "    auto [st, len] = M.longest();",
    "    cout << s.substr(st, len) << endl;",
    "    cout << M.count() << endl;",
    "    cout << M.is_pal(0, s.size() - 1) << endl;",
    "",
    "    $0",
    "}"
  ],
  "description": ""
},
"PalTree_integer": {
  "prefix": "PalTree_integer",
  "body": [
    "#include <bits/stdc++.h>",
    "using namespace std;",
    "",
    "// Time: O(n log A), Memory: O(n)",
    "struct PalTree",
    "{",
    "    vector<long long> len, link, cnt, diff, slink, dep, pos, s;",
    "    vector<map<long long, long long>> nxt;",
    "    struct Rec",
    "    {",
    "        long long prevLast, cur, c;",
    "        bool made;",
    "    };",
    "    vector<Rec> hist;",
    "    long long last;",
    "",
    "    // constructs an empty tree (calls init)",
    "    PalTree() { init(); }",
    "",
    "    // creates a new node with palindrome length l; returns its index",
    "    long long newNode(long long l)",
    "    {",
    "        len.push_back(l);",
    "        link.push_back(0);",
    "        cnt.push_back(0);",
    "        diff.push_back(0);",
    "        slink.push_back(0);",
    "        dep.push_back(0);",
    "        pos.push_back(-1);",
    "        nxt.emplace_back();",
    "        return (long long)len.size() - 1;",
    "    }",
    "",
    "    // resets the tree to empty state (two roots only)",
    "    void init()",
    "    {",
    "        len.clear();",
    "        link.clear();",
    "        cnt.clear();",
    "        diff.clear();",
    "        slink.clear();",
    "        dep.clear();",
    "        pos.clear();",
    "        nxt.clear();",
    "        s.clear();",
    "        hist.clear();",
    "        newNode(-1);",
    "        newNode(0);",
    "        link[0] = link[1] = 0;",
    "        last = 1;",
    "    }",
    "",
    "    // returns child of node v by symbol c, or 0 if no such edge",
    "    long long go(long long v, long long c) const",
    "    {",
    "        auto it = nxt[v].find(c);",
    "        return it == nxt[v].end() ? 0 : it->second;",
    "    }",
    "",
    "    // walks suffix links to find the node we can extend with s[p]",
    "    long long getLink(long long v, long long p)",
    "    {",
    "        while (p - 1 - len[v] < 0 || s[p - 1 - len[v]] != s[p])",
    "            v = link[v];",
    "        return v;",
    "    }",
    "",
    "    // appends symbol c; returns true if a new distinct palindrome was created",
    "    bool add(long long c)",
    "    {",
    "        s.push_back(c);",
    "        long long p = (long long)s.size() - 1, prev = last;",
    "        long long cur = getLink(last, p);",
    "        long long e = go(cur, c);",
    "        if (e)",
    "        {",
    "            last = e;",
    "            cnt[last]++;",
    "            hist.push_back({prev, cur, c, false});",
    "            return false;",
    "        }",
    "        long long v = newNode(len[cur] + 2);",
    "        if (len[v] == 1)",
    "            link[v] = 1;",
    "        else",
    "            link[v] = go(getLink(link[cur], p), c);",
    "        nxt[cur][c] = v;",
    "        cnt[v] = 1;",
    "        pos[v] = p;",
    "        dep[v] = dep[link[v]] + 1;",
    "        diff[v] = len[v] - len[link[v]];",
    "        slink[v] = (diff[v] == diff[link[v]]) ? slink[link[v]] : link[v];",
    "        hist.push_back({prev, cur, c, true});",
    "        last = v;",
    "        return true;",
    "    }",
    "",
    "    // convenience: appends char ch mapped via base, e.g. addChar('c') stores 2",
    "    bool addChar(char ch, char base = 'a') { return add((long long)(ch - base)); }",
    "",
    "    // undoes the most recent add (only valid before calc())",
    "    void undo()",
    "    {",
    "        if (hist.empty())",
    "            return;",
    "        Rec r = hist.back();",
    "        hist.pop_back();",
    "        if (r.made)",
    "        {",
    "            nxt[r.cur].erase(r.c);",
    "            len.pop_back();",
    "            link.pop_back();",
    "            cnt.pop_back();",
    "            diff.pop_back();",
    "            slink.pop_back();",
    "            dep.pop_back();",
    "            pos.pop_back();",
    "            nxt.pop_back();",
    "        }",
    "        else",
    "            cnt[last]--;",
    "        s.pop_back();",
    "        last = r.prevLast;",
    "    }",
    "",
    "    // propagates cnt through suffix links so cnt[v] = occurrences of node v",
    "    void calc()",
    "    {",
    "        for (long long i = (long long)len.size() - 1; i >= 2; i--)",
    "            cnt[link[i]] += cnt[i];",
    "    }",
    "",
    "    // returns number of distinct palindromic substrings",
    "    long long distinct() const { return (long long)len.size() - 2; }",
    "",
    "    // returns total palindromic substrings (call after calc())",
    "    long long total() const",
    "    {",
    "        long long t = 0;",
    "        for (long long i = 2; i < (long long)len.size(); i++)",
    "            t += cnt[i];",
    "        return t;",
    "    }",
    "",
    "    // returns [l, r] of first occurrence of node v's palindrome (v >= 2)",
    "    pair<long long, long long> range(long long v) const",
    "    {",
    "        return {pos[v] - len[v] + 1, pos[v]};",
    "    }",
    "",
    "    // returns current string length (number of symbols added minus undone)",
    "    long long size() const { return (long long)s.size(); }",
    "};",
    "",
    "signed main()",
    "{",
    "    ios::sync_with_stdio(false);",
    "    cin.tie(nullptr);",
    "",
    "    long long t;",
    "    cin >> t;",
    "    PalTree T;",
    "    while (t--)",
    "    {",
    "        long long n;",
    "        cin >> n;",
    "        T.init();",
    "        for (long long i = 0; i < n; i++)",
    "        {",
    "            long long x;",
    "            cin >> x;",
    "            T.add(x);",
    "        }",
    "        T.calc();",
    "        cout << T.distinct() << \" \" << T.total() << endl;",
    "    }",
    "    $0",
    "    return 0;",
    "}"
  ],
  "description": ""
},
"paltree_char": {
  "prefix": "paltree_char",
  "body": [
    "#include <bits/stdc++.h>",
    "using namespace std;",
    "",
    "struct paltree",
    "{",
    "    vector<long long> len, link, cnt, dep, pos, head, sib;",
    "    vector<unsigned char> ch;",
    "    long long last;",
    "",
    "    // build empty tree with 2 roots",
    "    explicit paltree(long long n)",
    "    {",
    "        len.reserve(n + 2);",
    "        link.reserve(n + 2);",
    "        cnt.reserve(n + 2);",
    "        dep.reserve(n + 2);",
    "        pos.reserve(n + 2);",
    "        head.reserve(n + 2);",
    "        sib.reserve(n + 2);",
    "        ch.reserve(n + 2);",
    "        newnode(-1);",
    "        newnode(0);",
    "        link[0] = link[1] = 0;",
    "        last = 1;",
    "    }",
    "",
    "    // create node with palindrome length l",
    "    long long newnode(long long l)",
    "    {",
    "        len.push_back(l);",
    "        link.push_back(0);",
    "        cnt.push_back(0);",
    "        dep.push_back(0);",
    "        pos.push_back(-1);",
    "        head.push_back(0);",
    "        sib.push_back(0);",
    "        ch.push_back(0);",
    "        return (long long)len.size() - 1;",
    "    }",
    "",
    "    // find child of v with edge label c",
    "    long long find(long long v, long long c) const",
    "    {",
    "        for (long long x = head[v]; x; x = sib[x])",
    "        {",
    "            if (ch[x] == c)",
    "                return x;",
    "        }",
    "        return 0;",
    "    }",
    "",
    "    // walk suffix links until s[p] can extend",
    "    long long getlink(const string &s, long long v, long long p) const",
    "    {",
    "        while (p - 1 - len[v] < 0 || s[p - 1 - len[v]] != s[p])",
    "        {",
    "            v = link[v];",
    "        }",
    "        return v;",
    "    }",
    "",
    "    // append s[p]; return true if new palindrome created",
    "    bool add(const string &s, long long p)",
    "    {",
    "        long long c = s[p] - 'a';",
    "        long long cur = getlink(s, last, p);",
    "        long long x = find(cur, c);",
    "",
    "        if (x)",
    "        {",
    "            last = x;",
    "            cnt[last]++;",
    "            return false;",
    "        }",
    "",
    "        long long v = newnode(len[cur] + 2);",
    "",
    "        if (len[v] == 1)",
    "            link[v] = 1;",
    "        else",
    "            link[v] = find(getlink(s, link[cur], p), c);",
    "",
    "        ch[v] = (unsigned char)c;",
    "        sib[v] = head[cur];",
    "        head[cur] = v;",
    "",
    "        cnt[v] = 1;",
    "        pos[v] = p;",
    "        dep[v] = dep[link[v]] + 1;",
    "        last = v;",
    "        return true;",
    "    }",
    "",
    "    // propagate cnt up suffix links",
    "    void calc()",
    "    {",
    "        for (long long i = (long long)len.size() - 1; i >= 2; i--)",
    "        {",
    "            cnt[link[i]] += cnt[i];",
    "        }",
    "    }",
    "",
    "    // number of distinct palindromes",
    "    long long distinct() const { return (long long)len.size() - 2; }",
    "",
    "    // total palindromes counting occurrences",
    "    long long total() const",
    "    {",
    "        long long t = 0;",
    "        for (long long i = 2; i < (long long)len.size(); i++)",
    "        {",
    "            t += cnt[i];",
    "        }",
    "        return t;",
    "    }",
    "",
    "    // first occurrence interval of node v",
    "    pair<long long, long long> range(long long v) const",
    "    {",
    "        return {pos[v] - len[v] + 1, pos[v]};",
    "    }",
    "",
    "    // number of nodes excluding roots",
    "    long long size() const { return (long long)head.size() - 2; }",
    "};",
    "",
    "signed main()",
    "{",
    "    ios::sync_with_stdio(false);",
    "    cin.tie(nullptr);",
