"modInverse": {
  "prefix": "modinverse",
  "body": [
    "long long modInverse(long long a, long long m) ",
    "{",
    "    long long res = 1;",
    "    long long power = m - 2;",
    "    while (power > 0)",
    "    {",
    "        if (power & 1)",
    "        {",
    "            res = (res * a) % m;",
    "        }",
    "        a = (a * a) % m;",
    "        power >>= 1;",
    "    }",
    "    return res;",
    "}"
  ],
  "description": ""
