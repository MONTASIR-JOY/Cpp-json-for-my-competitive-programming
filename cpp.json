"kmp": {
  "prefix": "kmp",
  "body": [
    "vector<long long> kmp(const string &s)",
    "{",
    "    long long n = s.size();",
    "    vector<long long> pi(n, 0);",
    "    for (long long i = 1; i < n; i++)",
    "    {",
    "        long long j = pi[i - 1];",
    "        while (j > 0 && s[i] != s[j])",
    "        {",
    "            j = pi[j - 1];",
    "        }",
    "        if (s[i] == s[j])",
    "        {",
    "            j++;",
    "        }",
    "        pi[i] = j;",
    "    }",
    "    return pi;",
    "}"
  ],
  "description": "kmp"
},
"zalgorithm": {
  "prefix": "zalgorithm",
  "body": [
    "vector<long long> z_function(const string &s)",
    "{",
    "    long long n = s.size();",
    "    vector<long long> z(n, 0);",
    "    long long l = 0, r = 0;",
    "",
    "    for (long long i = 1; i < n; i++)",
    "    {",
    "        if (i <= r)",
    "        {",
    "            z[i] = min(r - i + 1, z[i - l]);",
    "        }",
    "        while (i + z[i] < n && s[z[i]] == s[i + z[i]])",
    "        {",
    "            z[i]++;",
    "        }",
    "        if (i + z[i] - 1 > r)",
    "        {",
    "            l = i;",
    "            r = i + z[i] - 1;",
    "        }",
    "    }",
    "",
    "    return z;",
    "}"
  ],
  "description": "zalgorithm"
},
