"HLD": {
  "prefix": "HLD",
  "body": [
    "#include <bits/stdc++.h>",
    "using namespace std;",
    "",
    "const long long maxN = 2e5 + 9;",
    "long long a[maxN], t[4 * maxN], lazy[4 * maxN];",
    "",
    "void build(long long node, long long start, long long end)",
    "{",
    "    lazy[node] = 0;                          // change this",
    "    if (start == end)",
    "    {",
    "        t[node] = a[start];",
    "        return;",
    "    }",
    "    long long mid = (start + end) / 2;       //     node",
    "    long long left = 2 * node;                /*    / \\     */",
    "    long long right = 2 * node + 1;         //   left right",
    "    build(left, start, mid);",
    "    build(right, mid + 1, end);",
    "    t[node] = t[left] + t[right];              // change this",
    "}",
    "",
    "void push(long long node, long long start, long long end)",
    "{",
    "    if (lazy[node] == 0)                       // change this",
    "    {",
    "        return;",
    "    }",
    "    t[node] += (end - start + 1) * lazy[node]; // change this",
    "    if (start != end)",
    "    {",
    "        long long left = 2 * node;",
    "        long long right = 2 * node + 1;",
    "        lazy[left] += lazy[node];",
    "        lazy[right] += lazy[node];",
    "    }",
    "    lazy[node] = 0;                           // change this",
    "}",
    "",
    "void update(long long node, long long start, long long end, long long l, long long r, long long val)",
    "{",
    "    push(node, start, end);",
    "    if (end < l || r < start)",
    "    {",
    "        return;",
    "    }",
    "    if (start >= l && end <= r)",
    "    {",
    "        lazy[node] += val;                 // change this",
    "        push(node, start, end);",
    "        return;",
    "    }",
    "    long long mid = (start + end) / 2;     //     node",
    "    long long left = 2 * node;              /*    / \\     */",
    "    long long right = 2 * node + 1;       //   left right",
    "    update(left, start, mid, l, r, val);",
    "    update(right, mid + 1, end, l, r, val);",
    "    t[node] = t[left] + t[right];         // change this",
    "}",
    "",
    "long long query(long long node, long long start, long long end, long long l, long long r)",
    "{",
    "    push(node, start, end);",
    "    if (end < l || r < start)",
    "    {",
    "        return 0;     // change this sum=0, max=-1e18, min=1e18, xor=0, gcd=0",
    "    }",
    "    if (start >= l && end <= r)",
    "    {",
    "        return t[node];",
    "    }",
    "    long long mid = (start + end) / 2;                                       //     node",
    "    long long left = 2 * node;                                               /*    / \\     */",
    "    long long right = 2 * node + 1;                                          //   left right",
    "    return query(left, start, mid, l, r) + query(right, mid + 1, end, l, r); // change this",
    "}",
    "",
    "",
    "// HLD",
    "vector<long long> g[maxN];",
    "long long parent_[maxN], depth_[maxN], heavy[maxN], head[maxN], pos[maxN], subtreeSize[maxN];",
    "long long cur_pos = 0;",
    "",
    "long long dfs(long long u, long long p)",
    "{",
    "    long long size = 1;",
    "    long long max_c_size = 0;",
    "    heavy[u] = -1;",
    "    for (long long v : g[u])",
    "    {",
    "        if (v != p)",
    "        {",
    "            parent_[v] = u;",
    "            depth_[v] = depth_[u] + 1;",
    "            long long c_size = dfs(v, u);",
    "            size += c_size;",
    "            if (c_size > max_c_size)",
    "            {",
    "                max_c_size = c_size;",
    "                heavy[u] = v;",
    "            }",
    "        }",
    "    }",
    "    subtreeSize[u] = size;",
    "    return size;",
    "}",
    "",
    "void decompose(long long u, long long h)",
    "{",
    "    head[u] = h;",
    "    pos[u] = ++cur_pos;",
    "    if (heavy[u] != -1)",
    "    {",
    "        decompose(heavy[u], h);",
    "    }",
    "    for (long long v : g[u])",
    "    {",
    "        if (v != parent_[u] && v != heavy[u])",
    "        {",
    "            decompose(v, v);",
    "        }",
    "    }",
    "}",
    "",
    "void init(long long root)",
    "{",
    "    cur_pos = 0;",
    "    dfs(root, 0);",
    "    decompose(root, root);",
    "}",
    "",
    "",
    "template <class Op>",
    "void processPath(long long u, long long v, Op op)",
    "{",
    "    for (; head[u] != head[v]; v = parent_[head[v]])",
    "    {",
    "        if (depth_[head[u]] > depth_[head[v]])",
    "        {",
    "            swap(u, v);",
    "        }",
    "        op(pos[head[v]], pos[v]);",
    "    }",
    "    if (depth_[u] > depth_[v])",
    "    {",
    "        swap(u, v);",
    "    }",
    "    op(pos[u], pos[v]);",
    "}",
    "",
    "long long lca(long long u, long long v)",
    "{",
    "    while (head[u] != head[v])",
    "    {",
    "        if (depth_[head[u]] > depth_[head[v]]) u = parent_[head[u]];",
    "        else v = parent_[head[v]];",
    "    }",
    "    return (depth_[u] < depth_[v]) ? u : v;",
    "}",
    "",
    "",
    "long long pathSum(long long u, long long v)",
    "{",
    "    long long res = 0;",
    "    processPath(u, v, [&](long long l, long long r)",
    "    {",
    "        //  CHANGE HERE",
    "        res += query(1, 1, cur_pos, l, r); });",
    "    return res;",
    "}",
    "",
    "void pathAdd(long long u, long long v, long long x)",
    "{",
    "    processPath(u, v, [&](long long l, long long r)",
    "    {",
    "        //  CHANGE HERE",
    "        update(1, 1, cur_pos, l, r, x); });",
    "}",
    "",
    "long long subtreeSum(long long u)",
    "{",
    "    return query(1, 1, cur_pos, pos[u], pos[u] + subtreeSize[u] - 1);",
    "}",
    "",
    "void subtreeAdd(long long u, long long x)",
    "{",
    "    update(1, 1, cur_pos, pos[u], pos[u] + subtreeSize[u] - 1, x);",
    "}",
    "",
    "void pointSet(long long u, long long x)",
    "{",
    "    long long cur = query(1, 1, cur_pos, pos[u], pos[u]);",
    "    update(1, 1, cur_pos, pos[u], pos[u], x - cur);",
    "}",
    "",
    "signed main()",
    "{",
    "    ios::sync_with_stdio(false);",
    "    cin.tie(nullptr);",
    "",
    "    long long n, m;",
    "    cin >> n >> m;",
    "",
    "    for (long long i = 1; i < n; i++)",
    "    {",
    "        long long u, v;",
    "        cin >> u >> v;",
    "        g[u].push_back(v);",
    "        g[v].push_back(u);",
    "    }",
    "",
    "    vector<long long> val(n + 1);",
    "    for (long long i = 1; i <= n; i++)",
    "    {",
    "        cin >> val[i];",
    "    }",
    "",
    "    init(1);",
    "",
    "    for (long long u = 1; u <= n; u++)",
    "    {",
    "        a[pos[u]] = val[u];",
    "    }",
    "    build(1, 1, n);",
    "",
    "    while (m--)",
    "    {",
    "        long long type;",
    "        cin >> type;",
    "",
    "        if (type == 1)",
    "        {",
    "            long long u, v;",
    "            cin >> u >> v;",
    "            cout << pathSum(u, v) << endl;",
    "        }",
    "        else if (type == 2)",
    "        {",
    "            long long u, v, x;",
    "            cin >> u >> v >> x;",
    "            pathAdd(u, v, x);",
    "        }",
    "        else if (type == 3)",
    "        {",
    "            long long u, x;",
    "            cin >> u >> x;",
    "            pointSet(u, x);",
    "        }",
    "        else if (type == 4)",
    "        {",
    "            long long u;",
    "            cin >> u;",
    "            cout << subtreeSum(u) << endl;",
    "        }",
    "        else if (type == 5)",
    "        {",
    "            long long u, x;",
    "            cin >> u >> x;",
    "            subtreeAdd(u, x);",
    "        }",
    "    }",
    "    $0",
    "    return 0;",
    "}"
  ],
  "description": ""
},
