"toposort": {
  "prefix": "toposort",
  "body": [
    "#include <bits/stdc++.h>",
    "using namespace std;",
    "",
    "const long long MXN = 3e5 + 5;",
    "",
    "vector<long long> g[MXN];",
    "vector<long long> topo;",
    "long long state[MXN];",
    "bool hasCycle;",
    "",
    "void dfs(long long u)",
    "{",
    "    state[u] = 1;",
    "",
    "    for (long long v : g[u])",
    "    {",
    "        if (state[v] == 0)",
    "        {",
    "            dfs(v);",
    "            if (hasCycle) return;",
    "        }",
    "        else if (state[v] == 1)",
    "        {",
    "            hasCycle = true;",
    "            return;",
    "        }",
    "    }",
    "",
    "    state[u] = 2;",
    "    topo.push_back(u);",
    "}",
    "",
    "vector<long long> topological_sort(long long n)",
    "{",
    "    topo.clear();",
    "    hasCycle = false;",
    "",
    "    for (long long i = 1; i <= n; i++)",
    "        state[i] = 0;",
    "",
    "    for (long long i = 1; i <= n; i++)",
    "    {",
    "        if (state[i] == 0)",
    "        {",
    "            dfs(i);",
    "            if (hasCycle) return {};",
    "        }",
    "    }",
    "",
    "    reverse(topo.begin(), topo.end());",
    "    return topo;",
    "}",
    "",
    "int main()",
    "{",
    "    ios::sync_with_stdio(false);",
    "    cin.tie(nullptr);",
    "",
    "    long long n, m;",
    "    cin >> n >> m;",
    "",
    "    for (long long i = 1; i <= n; i++)",
    "    {",
    "        g[i].clear();",
    "    }",
    "",
    "    while (m--)",
    "    {",
    "        long long u, v;",
    "        cin >> u >> v;",
    "        g[u].push_back(v);",
    "    }",
    "",
    "    vector<long long> ans = topological_sort(n);",
    "",
    "    if (ans.empty())",
    "    {",
    "        cout << \"Cycle Found\" << endl;",
    "    }",
    "    else",
    "    {",
    "        for (long long i : ans)",
    "        {",
    "            cout << i << \" \";",
    "        }",
    "        cout << endl;",
    "    }",
    "",
    "    return 0;",
    "}"
  ],
  "description": ""
},
"dijkstra": {
  "prefix": "dijkstra",
  "body": [
    "#include <bits/stdc++.h>",
    "using namespace std;",
    "",
    "const long long mxn = 2e5 + 9;",
    "",
    "vector<pair<long long, long long>> g[mxn];",
    "vector<bool> vis(mxn);",
    "vector<long long> dis(mxn);",
    "vector<long long> parent(mxn);",
    "",
    "void dijkstra(long long src)",
    "{",
    "    priority_queue<pair<long long, long long>, vector<pair<long long, long long>>, greater<pair<long long, long long>>> pq;",
    "",
    "    dis[src] = 0;",
    "    pq.push({0, src});",
    "",
    "    while (!pq.empty())",
    "    {",
    "        auto [d, u] = pq.top();",
    "        pq.pop();",
    "",
    "        if (vis[u])",
    "            continue;",
    "        vis[u] = true;",
    "",
    "        for (auto [v, w] : g[u])",
    "        {",
    "            if (!vis[v] && dis[u] + w < dis[v])",
    "            {",
    "                dis[v] = dis[u] + w;",
    "                parent[v] = u;",
    "                pq.push({dis[v], v});",
    "            }",
    "        }",
    "    }",
    "}",
    "",
    "int main()",
    "{",
    "    ios::sync_with_stdio(false);",
    "    cin.tie(nullptr);",
    "",
    "    int n;",
    "    cin >> n;",
    "",
    "    for (long long i = 0; i <= n;i++)",
    "    {",
    "        g[i].clear();",
    "        vis[i] = false;",
    "        dis[i] = LLONG_MAX;",
    "        parent[i] = -1;",
    "    }",
    "",
    "    for (long long i = 0; i < n - 1;i++)",
    "    {",
    "        long long u, v;",
    "        long long w;",
    "        cin >> u >> v >> w;",
    "        g[u].push_back({v, w});",
    "        g[v].push_back({u, w});",
    "    }",
    "",
    "    long long src, dest;",
    "    cin >> src >> dest;",
    "    dis[src] = 0;",
    "    dijkstra(src);",
    "",
    "    cout << dis[dest] << endl;",
    "",
    "    return 0;",
    "}"
  ],
  "description": ""
},
"knapsack": {
  "prefix": "knapsack",
  "body": [
    "#include <bits/stdc++.h>",
    "using namespace std;",
    "",
    "int main()",
    "{",
    "    ios_base::sync_with_stdio(false);",
    "    cin.tie(NULL);",
    "",
    "    long long n, W;",
    "    cin >> n >> W;",
    "",
    "    vector<long long> weight(n);",
    "    vector<long long> value(n);",
    "    for (long long i = 0; i < n; i++)",
    "    {",
    "        cin >> weight[i];",
    "    }",
    "    for (long long i = 0; i < n; i++)",
    "    {",
    "        cin >> value[i];",
    "    }",
    "",
    "    vector<long long> dp(W + 1, 0);",
    "",
    "    for (long long i = 0; i < n; i++)",
    "    {",
    "        for (long long j = W; j >= weight[i]; j--)",
    "        {",
    "            dp[j] = max(dp[j], dp[j - weight[i]] + value[i]);",
    "        }",
    "    }",
    "",
    "    cout << dp[W] << endl;",
    "    return 0;",
    "}"
  ],
  "description": ""
},
"kmp": {
  "prefix": "kmp",
  "body": [
    "vector<long long> kmp(const string &s)",
    "{",
    "    long long n = s.size();",
    "    vector<long long> pi(n, 0);",
    "    for (long long i = 1; i < n; i++)",
    "    {",
    "        long long j = pi[i - 1];",
    "        while (j > 0 && s[i] != s[j])",
    "        {",
    "            j = pi[j - 1];",
    "        }",
    "        if (s[i] == s[j])",
    "        {",
    "            j++;",
    "        }",
    "        pi[i] = j;",
    "    }",
    "    return pi;",
    "}"
  ],
  "description": "kmp"
},
"zalgorithm": {
  "prefix": "zalgorithm",
  "body": [
    "vector<long long> z_function(const string &s)",
    "{",
    "    long long n = s.size();",
    "    vector<long long> z(n, 0);",
    "    long long l = 0, r = 0;",
    "",
    "    for (long long i = 1; i < n; i++)",
    "    {",
    "        if (i <= r)",
    "        {",
    "            z[i] = min(r - i + 1, z[i - l]);",
    "        }",
    "        while (i + z[i] < n && s[z[i]] == s[i + z[i]])",
    "        {",
    "            z[i]++;",
    "        }",
    "        if (i + z[i] - 1 > r)",
    "        {",
    "            l = i;",
    "            r = i + z[i] - 1;",
    "        }",
    "    }",
    "",
    "    return z;",
    "}"
  ],
  "description": "zalgorithm"
}
